{
    "#doc": "The room-period editor: ON time, OFF time, temperature.",
    "#element": "div",
    "@id": "period-editor",
    "font-family": "Helvetica, Arial, SansSerif",
    "font-weight": "bold",
    "padding": "0.5em 1em",
    "#": ["$OnRow", "$OffRow", "$BottomRow"],

    "$OnRow": {
        "#element": "div",
        "display": "flex",
        "align-items": "center",
        "padding": "0.3em 0",
        "#": ["$OnLabel", "$OnHourDown", "$OnHourUp", "$OnHour", "$Colon1", "$OnMinute", "$OnMinuteDown", "$OnMinuteUp", "$Pad"],

        "$OnLabel": {
            "#element": "div",
            "min-width": "2.5em",
            "#content": "ON"
        },
        "$OnHourDown": {
            "#element": "img",
            "@id": "on-hour-down",
            "@src": "resources/icon/down.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$OnHourUp": {
            "#element": "img",
            "@id": "on-hour-up",
            "@src": "resources/icon/up.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$OnHour": {
            "#element": "div",
            "@id": "on-hour-text",
            "#content": "00"
        },
        "$Colon1": {
            "#element": "div",
            "#content": ":"
        },
        "$OnMinute": {
            "#element": "div",
            "@id": "on-minute-text",
            "#content": "00"
        },
        "$OnMinuteDown": {
            "#element": "img",
            "@id": "on-minute-down",
            "@src": "resources/icon/down.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$OnMinuteUp": {
            "#element": "img",
            "@id": "on-minute-up",
            "@src": "resources/icon/up.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$Pad": {
            "#element": "div",
            "flex": 1
        }
    },

    "$OffRow": {
        "#element": "div",
        "display": "flex",
        "align-items": "center",
        "padding": "0.3em 0",
        "#": ["$OffLabel", "$OffHourDown", "$OffHourUp", "$OffHour", "$Colon2", "$OffMinute", "$OffMinuteDown", "$OffMinuteUp", "$Pad"],

        "$OffLabel": {
            "#element": "div",
            "min-width": "2.5em",
            "#content": "OFF"
        },
        "$OffHourDown": {
            "#element": "img",
            "@id": "off-hour-down",
            "@src": "resources/icon/down.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$OffHourUp": {
            "#element": "img",
            "@id": "off-hour-up",
            "@src": "resources/icon/up.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$OffHour": {
            "#element": "div",
            "@id": "off-hour-text",
            "#content": "00"
        },
        "$Colon2": {
            "#element": "div",
            "#content": ":"
        },
        "$OffMinute": {
            "#element": "div",
            "@id": "off-minute-text",
            "#content": "00"
        },
        "$OffMinuteDown": {
            "#element": "img",
            "@id": "off-minute-down",
            "@src": "resources/icon/down.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$OffMinuteUp": {
            "#element": "img",
            "@id": "off-minute-up",
            "@src": "resources/icon/up.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$Pad": {
            "#element": "div",
            "flex": 1
        }
    },

    "$BottomRow": {
        "#element": "div",
        "display": "flex",
        "align-items": "center",
        "padding": "0.3em 0",
        "#": ["$TempDown", "$Temp", "$TempUp", "$Pad", "$Save", "$Delete"],

        "$TempDown": {
            "#element": "img",
            "@id": "temp-down",
            "@src": "resources/icon/down.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$Temp": {
            "#element": "div",
            "@id": "temp-text",
            "#content": "0.0&deg;C"
        },
        "$TempUp": {
            "#element": "img",
            "@id": "temp-up",
            "@src": "resources/icon/up.png",
            "width": "1.3em",
            "height": "1.3em",
            "padding": "0 0.25em",
            "cursor": "pointer"
        },
        "$Pad": {
            "#element": "div",
            "flex": 1
        },
        "$Save": {
            "#element": "img",
            "@id": "period-save",
            "@src": "resources/icon/save.png",
            "width": "1.2em",
            "height": "1.2em",
            "padding": "0 1em",
            "cursor": "pointer"
        },
        "$Delete": {
            "#element": "img",
            "@id": "period-delete",
            "@src": "resources/icon/delete.png",
            "width": "1.2em",
            "height": "1.2em",
            "cursor": "pointer"
        }
    }
}

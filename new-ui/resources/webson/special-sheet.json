{
    "#doc": "Special actions sheet — the one-off schedule tweaks a room can be given for a single day. Static Webson rendered once into sheet-content alongside the other simple sheets; shell.as opens it from the expansion's Special button. The Cancel-the-override row is hidden unless something is armed.",
    "#element": "div",
    "@id": "special-sheet",
    "#": ["$Tagline", "$StartAction", "$SkipAction", "$ClearAction", "$Buttons"],

    "$Tagline": {
        "#element": "div",
        "margin-top": "2px",
        "font-size": "13px",
        "font-weight": "400",
        "color": "var(--color-text-secondary)",
        "#content": "Change one morning without touching the schedule. The change is used once and then the room reverts by itself."
    },

    "$StartAction": {
        "#element": "button",
        "@id": "special-action-start",
        "width": "100%",
        "margin-top": "16px",
        "padding": "14px",
        "border": "1px solid var(--color-border-hairline)",
        "border-radius": "12px",
        "background": "var(--color-surface-card)",
        "cursor": "pointer",
        "font-family": "inherit",
        "text-align": "left",
        "display": "flex",
        "flex-direction": "column",
        "gap": "3px",
        "#": ["$StartLabel", "$StartSub"],

        "$StartLabel": {
            "#element": "div",
            "font-size": "14px",
            "font-weight": "500",
            "color": "var(--color-text-primary)",
            "#content": "Change the morning start time"
        },
        "$StartSub": {
            "#element": "div",
            "@id": "special-action-start-sub",
            "font-size": "12px",
            "font-weight": "400",
            "color": "var(--color-text-secondary)"
        }
    },

    "$SkipAction": {
        "#element": "button",
        "@id": "special-action-skip",
        "width": "100%",
        "margin-top": "10px",
        "padding": "14px",
        "border": "1px solid var(--color-border-hairline)",
        "border-radius": "12px",
        "background": "var(--color-surface-card)",
        "cursor": "pointer",
        "font-family": "inherit",
        "text-align": "left",
        "display": "flex",
        "flex-direction": "column",
        "gap": "3px",
        "#": ["$SkipLabel", "$SkipSub"],

        "$SkipLabel": {
            "#element": "div",
            "font-size": "14px",
            "font-weight": "500",
            "color": "var(--color-text-primary)",
            "#content": "Skip the morning warm-up"
        },
        "$SkipSub": {
            "#element": "div",
            "@id": "special-action-skip-sub",
            "font-size": "12px",
            "font-weight": "400",
            "color": "var(--color-text-secondary)"
        }
    },

    "$ClearAction": {
        "#doc": "Shown only while an override is armed. Cancel is the same operation the expansion's override row offers, kept here too so the sheet is a complete picture of the room's one-off state.",
        "#element": "button",
        "@id": "special-action-clear",
        "display": "none",
        "width": "100%",
        "margin-top": "10px",
        "padding": "14px",
        "border": "1px solid var(--color-accent)",
        "border-radius": "12px",
        "background": "var(--color-accent-10)",
        "cursor": "pointer",
        "font-family": "inherit",
        "text-align": "left",
        "font-size": "14px",
        "font-weight": "500",
        "color": "var(--color-accent)",
        "#content": "Cancel the override"
    },

    "$Buttons": {
        "#element": "div",
        "margin-top": "20px",
        "display": "flex",
        "gap": "10px",
        "#": ["$CloseBtn"],

        "$CloseBtn": {
            "#element": "button",
            "@id": "special-sheet-close-btn",
            "flex": "1",
            "padding": "12px",
            "border-radius": "12px",
            "background": "var(--color-surface-card)",
            "border": "1px solid var(--color-border-hairline)",
            "cursor": "pointer",
            "font-family": "inherit",
            "font-size": "14px",
            "font-weight": "500",
            "color": "var(--color-text-primary)",
            "#content": "Close"
        }
    }
}

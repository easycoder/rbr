{
    "#doc": "One row in the device-editor's room list. Tapping the name selects the room and closes the picker. Up/Down reorder, Edit renames (prompt), Delete removes (confirm). All operations mutate the EditingProfilesForDevices working copy in shell.as. /I/ is replaced with the room index per render.",
    "#element": "div",
    "@id": "device-room-edit-/I/",
    "padding": "6px 8px",
    "border": "1px solid var(--color-border-hairline)",
    "border-radius": "10px",
    "background": "var(--color-surface-card)",
    "display": "flex",
    "align-items": "center",
    "gap": "2px",
    "#": ["$Name", "$BtnUp", "$BtnDown", "$BtnEdit", "$BtnDelete"],

    "$Name": {
        "#element": "button",
        "@id": "device-room-edit-/I/-name",
        "flex": "1",
        "min-width": "0",
        "background": "transparent",
        "border": "0",
        "padding": "6px 4px",
        "color": "var(--color-text-primary)",
        "font-family": "inherit",
        "font-size": "14px",
        "font-weight": "500",
        "text-align": "left",
        "cursor": "pointer",
        "white-space": "nowrap",
        "overflow": "hidden",
        "text-overflow": "ellipsis"
    },

    "$BtnUp": {
        "#element": "button",
        "@id": "device-room-edit-/I/-up",
        "width": "28px",
        "height": "28px",
        "padding": "0",
        "border": "0",
        "background": "transparent",
        "border-radius": "6px",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "flex-shrink": "0",
        "#": "$UpIcon",
        "$UpIcon": {
            "#element": "div",
            "width": "12px",
            "height": "12px",
            "background-color": "var(--color-text-secondary)",
            "mask": "url(resources/icon/chevron.svg) center/contain no-repeat",
            "-webkit-mask": "url(resources/icon/chevron.svg) center/contain no-repeat",
            "transform": "rotate(180deg)",
            "pointer-events": "none"
        }
    },

    "$BtnDown": {
        "#element": "button",
        "@id": "device-room-edit-/I/-down",
        "width": "28px",
        "height": "28px",
        "padding": "0",
        "border": "0",
        "background": "transparent",
        "border-radius": "6px",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "flex-shrink": "0",
        "#": "$DownIcon",
        "$DownIcon": {
            "#element": "div",
            "width": "12px",
            "height": "12px",
            "background-color": "var(--color-text-secondary)",
            "mask": "url(resources/icon/chevron.svg) center/contain no-repeat",
            "-webkit-mask": "url(resources/icon/chevron.svg) center/contain no-repeat",
            "pointer-events": "none"
        }
    },

    "$BtnEdit": {
        "#element": "button",
        "@id": "device-room-edit-/I/-edit",
        "width": "28px",
        "height": "28px",
        "padding": "0",
        "border": "0",
        "background": "transparent",
        "border-radius": "6px",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "flex-shrink": "0",
        "#": "$EditIcon",
        "$EditIcon": {
            "#element": "div",
            "width": "14px",
            "height": "14px",
            "background-color": "var(--color-text-secondary)",
            "mask": "url(resources/icon/edit.svg) center/contain no-repeat",
            "-webkit-mask": "url(resources/icon/edit.svg) center/contain no-repeat",
            "pointer-events": "none"
        }
    },

    "$BtnDelete": {
        "#element": "button",
        "@id": "device-room-edit-/I/-delete",
        "width": "28px",
        "height": "28px",
        "padding": "0",
        "border": "0",
        "background": "transparent",
        "border-radius": "6px",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "flex-shrink": "0",
        "#": "$DeleteIcon",
        "$DeleteIcon": {
            "#element": "div",
            "width": "14px",
            "height": "14px",
            "background-color": "var(--color-status-warn)",
            "mask": "url(resources/icon/close.svg) center/contain no-repeat",
            "-webkit-mask": "url(resources/icon/close.svg) center/contain no-repeat",
            "pointer-events": "none"
        }
    }
}

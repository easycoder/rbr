{
    "#doc": "RoomRow card. Outer is a column flex; the rest-row is always visible, the expansion block is hidden until shell.as toggles it. /I/ is substituted with the room's list index per render.",
    "#element": "div",
    "@id": "room-/I/-card",
    "background": "var(--color-surface-card)",
    "border-radius": "var(--radius-card)",
    "box-shadow": "var(--shadow-card)",
    "display": "flex",
    "flex-direction": "column",
    "transition": "box-shadow 0.2s",
    "#": ["$Rest", "$Expansion"],

    "$Rest": {
        "#element": "div",
        "@id": "room-/I/-rest",
        "padding": "14px var(--space-card-pad)",
        "display": "flex",
        "align-items": "center",
        "gap": "12px",
        "cursor": "pointer",
        "user-select": "none",
        "#": ["$Chip", "$TextBlock", "$Spacer", "$TempBlock", "$InfoBtn"],

        "$Chip": {
            "#element": "div",
            "@id": "room-/I/-chip",
            "width": "38px",
            "height": "38px",
            "border-radius": "12px",
            "background": "var(--color-chip-ok-bg)",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "flex-shrink": "0",
            "#": "$ChipIcon",

            "$ChipIcon": {
                "#element": "div",
                "@id": "room-/I/-chip-icon",
                "width": "18px",
                "height": "18px",
                "background-color": "var(--color-chip-ok-fg)",
                "mask": "url(resources/icon/clock.svg) center/contain no-repeat",
                "-webkit-mask": "url(resources/icon/clock.svg) center/contain no-repeat"
            }
        },

        "$TextBlock": {
            "#element": "div",
            "display": "flex",
            "flex-direction": "column",
            "gap": "2px",
            "min-width": "0",
            "#": ["$NameRow", "$Subline", "$WarnRow"],

            "$NameRow": {
                "#element": "div",
                "display": "flex",
                "align-items": "center",
                "gap": "8px",
                "#": ["$Name", "$HeatingTag", "$OfflineTag"],

                "$Name": {
                    "#element": "div",
                    "@id": "room-/I/-name",
                    "font-size": "var(--type-room-name-size)",
                    "font-weight": "var(--type-room-name-weight)",
                    "letter-spacing": "var(--type-room-name-track)",
                    "color": "var(--color-text-primary)"
                },

                "$HeatingTag": {
                    "#element": "div",
                    "@id": "room-/I/-heating-tag",
                    "display": "none",
                    "align-items": "center",
                    "gap": "3px",
                    "font-size": "10.5px",
                    "font-weight": "600",
                    "color": "var(--color-accent)",
                    "#": ["$Flame", "$Label"],

                    "$Flame": {
                        "#element": "div",
                        "width": "11px",
                        "height": "11px",
                        "background-color": "var(--color-accent)",
                        "mask": "url(resources/icon/flame.svg) center/contain no-repeat",
                        "-webkit-mask": "url(resources/icon/flame.svg) center/contain no-repeat"
                    },
                    "$Label": {
                        "#element": "span",
                        "#content": "heating"
                    }
                },

                "$OfflineTag": {
                    "#element": "div",
                    "@id": "room-/I/-offline-tag",
                    "display": "none",
                    "align-items": "center",
                    "gap": "3px",
                    "font-size": "10.5px",
                    "font-weight": "500",
                    "color": "var(--color-status-warn)",
                    "#": ["$WifiSlash", "$Label"],

                    "$WifiSlash": {
                        "#element": "div",
                        "width": "11px",
                        "height": "11px",
                        "background-color": "var(--color-status-warn)",
                        "mask": "url(resources/icon/offline.svg) center/contain no-repeat",
                        "-webkit-mask": "url(resources/icon/offline.svg) center/contain no-repeat"
                    },
                    "$Label": {
                        "#element": "span",
                        "#content": "offline"
                    }
                }
            },

            "$Subline": {
                "#element": "div",
                "@id": "room-/I/-subline",
                "font-size": "var(--type-subline-size)",
                "font-weight": "var(--type-subline-weight)",
                "color": "var(--color-text-secondary)",
                "white-space": "nowrap",
                "overflow": "hidden",
                "text-overflow": "ellipsis"
            },

            "$WarnRow": {
                "#doc": "Second line for warnings (relay not responding, no recent change, battery low). Own row so a warning never competes with the schedule text for space on the subline above; hidden when there is nothing to report.",
                "#element": "div",
                "@id": "room-/I/-warn-row",
                "display": "none",
                "align-items": "center",
                "gap": "4px",
                "margin-top": "3px",
                "min-width": "0",
                "font-size": "var(--type-warn-size, 11px)",
                "font-weight": "500",
                "color": "var(--color-status-warn)",
                "#": ["$WarnIcon", "$WarnText"],

                "$WarnIcon": {
                    "#element": "div",
                    "width": "10px",
                    "height": "10px",
                    "flex-shrink": "0",
                    "background-color": "var(--color-status-warn)",
                    "mask": "url(resources/icon/warning.svg) center/contain no-repeat",
                    "-webkit-mask": "url(resources/icon/warning.svg) center/contain no-repeat"
                },

                "$WarnText": {
                    "#element": "span",
                    "@id": "room-/I/-warn-text",
                    "flex": "1",
                    "min-width": "0",
                    "white-space": "nowrap",
                    "overflow": "hidden",
                    "text-overflow": "ellipsis"
                }
            }
        },

        "$Spacer": {
            "#element": "div",
            "flex": "1"
        },

        "$TempBlock": {
            "#element": "div",
            "display": "flex",
            "flex-direction": "column",
            "align-items": "flex-end",
            "flex-shrink": "0",
            "#": ["$CurrentRow", "$Setpoint"],

            "$CurrentRow": {
                "#element": "div",
                "display": "flex",
                "align-items": "baseline",
                "#": ["$Temp", "$Unit"],

                "$Temp": {
                    "#element": "span",
                    "@id": "room-/I/-temp",
                    "font-size": "var(--type-current-temp-size)",
                    "font-weight": "var(--type-current-temp-weight)",
                    "letter-spacing": "var(--type-current-temp-track)",
                    "color": "var(--color-text-primary)"
                },

                "$Unit": {
                    "#element": "span",
                    "font-size": "11px",
                    "color": "var(--color-text-muted)",
                    "margin-left": "2px",
                    "#content": "°C"
                }
            },

            "$Setpoint": {
                "#element": "div",
                "@id": "room-/I/-setpoint",
                "font-size": "11px",
                "color": "var(--color-text-muted)",
                "margin-top": "2px"
            }
        },

        "$InfoBtn": {
            "#doc": "Tap to open the room info sheet (relay state, last reading, battery, etc). The button's click handler in shell.as cancels event propagation, so a tap here opens the info sheet instead of toggling the row's expansion.",
            "#element": "button",
            "@id": "room-/I/-info-btn",
            "@aria-label": "Room info",
            "width": "28px",
            "height": "28px",
            "padding": "0",
            "border": "0",
            "background": "transparent",
            "border-radius": "50%",
            "cursor": "pointer",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "flex-shrink": "0",
            "#": "$InfoIcon",

            "$InfoIcon": {
                "#element": "div",
                "width": "16px",
                "height": "16px",
                "background-color": "var(--color-text-disabled)",
                "mask": "url(resources/icon/info.svg) center/contain no-repeat",
                "-webkit-mask": "url(resources/icon/info.svg) center/contain no-repeat",
                "pointer-events": "none"
            }
        }
    },

    "$Expansion": {
        "#element": "div",
        "@id": "room-/I/-expansion",
        "display": "none",
        "flex-direction": "column",
        "padding": "4px var(--space-card-pad) 18px var(--space-card-pad)",
        "border-top": "1px solid var(--color-border-divider-soft)",
        "#": ["$ModeBlock", "$TargetBlock", "$AdvanceBlock", "$BoostBlock", "$SpecialBlock"],

        "$ModeBlock": {
            "#element": "div",
            "#": ["$ModeLabel", "$ModePill"],

            "$ModeLabel": {
                "#element": "div",
                "margin": "14px 0 8px 0",
                "font-size": "var(--type-section-label-size)",
                "font-weight": "var(--type-section-label-weight)",
                "letter-spacing": "var(--type-section-label-track)",
                "color": "var(--color-text-meta)",
                "text-transform": "uppercase",
                "#content": "Mode"
            },
            "$ModePill": {
                "#element": "div",
                "background": "var(--color-surface-sunk)",
                "padding": "4px",
                "border-radius": "12px",
                "display": "grid",
                "grid-template-columns": "1fr 1fr 1fr 1fr",
                "gap": "6px",
                "#": [
                    {
                        "#element": "button",
                        "@id": "room-/I/-mode-timed",
                        "padding": "10px 6px",
                        "border": "0",
                        "border-radius": "9px",
                        "background": "transparent",
                        "color": "var(--color-text-muted)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "Timed"
                    },
                    {
                        "#element": "button",
                        "@id": "room-/I/-mode-boost",
                        "padding": "10px 6px",
                        "border": "0",
                        "border-radius": "9px",
                        "background": "transparent",
                        "color": "var(--color-text-muted)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "Boost"
                    },
                    {
                        "#element": "button",
                        "@id": "room-/I/-mode-on",
                        "padding": "10px 6px",
                        "border": "0",
                        "border-radius": "9px",
                        "background": "transparent",
                        "color": "var(--color-text-muted)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "On"
                    },
                    {
                        "#element": "button",
                        "@id": "room-/I/-mode-off",
                        "padding": "10px 6px",
                        "border": "0",
                        "border-radius": "9px",
                        "background": "transparent",
                        "color": "var(--color-text-muted)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "Off"
                    }
                ]
            }
        },

        "$TargetBlock": {
            "#element": "div",
            "@id": "room-/I/-target-block",
            "#": ["$TargetLabel", "$TargetRow"],

            "$TargetLabel": {
                "#element": "div",
                "margin": "16px 0 8px 0",
                "font-size": "var(--type-section-label-size)",
                "font-weight": "var(--type-section-label-weight)",
                "letter-spacing": "var(--type-section-label-track)",
                "color": "var(--color-text-meta)",
                "text-transform": "uppercase",
                "#content": "Target"
            },
            "$TargetRow": {
                "#element": "div",
                "display": "flex",
                "gap": "12px",
                "align-items": "stretch",
                "#": ["$Minus", "$Tile", "$Plus"],

                "$Minus": {
                    "#element": "button",
                    "@id": "room-/I/-target-minus",
                    "width": "54px",
                    "height": "54px",
                    "border-radius": "var(--radius-step-btn)",
                    "background": "var(--color-surface-card)",
                    "border": "0",
                    "cursor": "pointer",
                    "box-shadow": "var(--shadow-step-btn)",
                    "color": "var(--color-accent)",
                    "font-size": "22px",
                    "font-weight": "400",
                    "font-family": "inherit",
                    "flex-shrink": "0",
                    "padding": "0",
                    "#content": "−"
                },
                "$Tile": {
                    "#element": "div",
                    "flex": "1",
                    "padding": "14px 8px",
                    "background": "var(--color-accent-10)",
                    "border": "1px solid var(--color-accent-20)",
                    "border-radius": "var(--radius-target-tile)",
                    "display": "flex",
                    "flex-direction": "column",
                    "align-items": "center",
                    "justify-content": "center",
                    "#": ["$NumberRow", "$Caption"],

                    "$NumberRow": {
                        "#element": "div",
                        "display": "flex",
                        "align-items": "baseline",
                        "#": ["$Number", "$Unit"],

                        "$Number": {
                            "#element": "span",
                            "@id": "room-/I/-target-value",
                            "font-size": "var(--type-target-big-size)",
                            "font-weight": "var(--type-target-big-weight)",
                            "letter-spacing": "var(--type-target-big-track)",
                            "color": "var(--color-text-primary)"
                        },
                        "$Unit": {
                            "#element": "span",
                            "font-size": "15px",
                            "font-weight": "500",
                            "color": "var(--color-accent)",
                            "margin-left": "4px",
                            "#content": "°C"
                        }
                    },
                    "$Caption": {
                        "#element": "div",
                        "font-size": "11px",
                        "font-weight": "400",
                        "color": "var(--color-text-secondary)",
                        "margin-top": "4px",
                        "#content": "Target temperature"
                    }
                },
                "$Plus": {
                    "#element": "button",
                    "@id": "room-/I/-target-plus",
                    "width": "54px",
                    "height": "54px",
                    "border-radius": "var(--radius-step-btn)",
                    "background": "var(--color-surface-card)",
                    "border": "0",
                    "cursor": "pointer",
                    "box-shadow": "var(--shadow-step-btn)",
                    "color": "var(--color-accent)",
                    "font-size": "22px",
                    "font-weight": "400",
                    "font-family": "inherit",
                    "flex-shrink": "0",
                    "padding": "0",
                    "#content": "+"
                }
            }
        },

        "$AdvanceBlock": {
            "#doc": "Advance control. No section label — the button text names the action, and the block is only ever shown on its own between the target tile and the boost row.",
            "#element": "div",
            "@id": "room-/I/-advance-block",
            "#": ["$AdvanceBtn"],

            "$AdvanceBtn": {
                "#element": "button",
                "@id": "room-/I/-advance-btn",
                "width": "100%",
                "margin-top": "16px",
                "padding": "12px 14px",
                "border": "1px solid var(--color-border-hairline)",
                "border-radius": "12px",
                "background": "var(--color-surface-card)",
                "color": "var(--color-text-primary)",
                "font-family": "inherit",
                "font-size": "14px",
                "font-weight": "500",
                "cursor": "pointer",
                "text-align": "center",
                "#content": "Advance to next schedule period"
            }
        },

        "$BoostBlock": {
            "#element": "div",
            "@id": "room-/I/-boost-block",
            "#": ["$BoostLabel", "$BoostGrid"],

            "$BoostLabel": {
                "#element": "div",
                "margin": "18px 0 8px 0",
                "font-size": "var(--type-section-label-size)",
                "font-weight": "var(--type-section-label-weight)",
                "letter-spacing": "var(--type-section-label-track)",
                "color": "var(--color-text-meta)",
                "text-transform": "uppercase",
                "#content": "Boost"
            },
            "$BoostGrid": {
                "#element": "div",
                "display": "grid",
                "grid-template-columns": "1fr 1fr 1fr 1fr",
                "gap": "6px",
                "#": [
                    {
                        "#element": "button",
                        "@id": "room-/I/-boost-off",
                        "padding": "10px 6px",
                        "background": "var(--color-surface-card)",
                        "border": "1px solid var(--color-border-hairline)",
                        "border-radius": "10px",
                        "color": "var(--color-text-primary)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "Off"
                    },
                    {
                        "#element": "button",
                        "@id": "room-/I/-boost-30",
                        "padding": "10px 6px",
                        "background": "var(--color-surface-card)",
                        "border": "1px solid var(--color-border-hairline)",
                        "border-radius": "10px",
                        "color": "var(--color-text-primary)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "30 min"
                    },
                    {
                        "#element": "button",
                        "@id": "room-/I/-boost-1h",
                        "padding": "10px 6px",
                        "background": "var(--color-surface-card)",
                        "border": "1px solid var(--color-border-hairline)",
                        "border-radius": "10px",
                        "color": "var(--color-text-primary)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "1 hr"
                    },
                    {
                        "#element": "button",
                        "@id": "room-/I/-boost-2h",
                        "padding": "10px 6px",
                        "background": "var(--color-surface-card)",
                        "border": "1px solid var(--color-border-hairline)",
                        "border-radius": "10px",
                        "color": "var(--color-text-primary)",
                        "font-family": "inherit",
                        "font-size": "13px",
                        "font-weight": "500",
                        "cursor": "pointer",
                        "#content": "2 hr"
                    }
                ]
            }
        },

        "$SpecialBlock": {
            "#doc": "The two per-room secondary actions, side by side to keep the expansion compact: the Special actions button (one-off schedule tweaks) and Edit schedule. Neither carries a section label — the button text names each one. The override row beneath appears only while something is armed and is the user's visible reminder; the override cancels itself once its morning has passed.",
            "#element": "div",
            "#": ["$ActionRow", "$OverrideRow"],

            "$ActionRow": {
                "#element": "div",
                "display": "flex",
                "gap": "10px",
                "margin-top": "18px",
                "#": ["$SpecialBtn", "$EditScheduleBtn"],

                "$SpecialBtn": {
                    "#element": "button",
                    "@id": "room-/I/-special-btn",
                    "flex": "1",
                    "min-width": "0",
                    "padding": "12px 14px",
                    "border": "1px solid var(--color-border-hairline)",
                    "border-radius": "12px",
                    "background": "var(--color-surface-card)",
                    "color": "var(--color-text-primary)",
                    "font-family": "inherit",
                    "font-size": "13.5px",
                    "font-weight": "500",
                    "cursor": "pointer",
                    "text-align": "center",
                    "#content": "Special actions…"
                },
                "$EditScheduleBtn": {
                    "#element": "button",
                    "@id": "room-/I/-edit-schedule",
                    "flex": "1",
                    "min-width": "0",
                    "padding": "12px 14px",
                    "border": "1px solid var(--color-border-hairline)",
                    "border-radius": "12px",
                    "background": "var(--color-surface-card)",
                    "cursor": "pointer",
                    "font-family": "inherit",
                    "font-size": "13.5px",
                    "font-weight": "500",
                    "color": "var(--color-text-primary)",
                    "text-align": "center",
                    "#content": "Edit schedule"
                }
            },

            "$OverrideRow": {
                "#doc": "Armed-override status line. Hidden unless the room has a one-off override waiting for today or tomorrow's morning. Accent-coloured so it reads as an active state rather than a warning, with a Cancel button so the user can withdraw it without opening the sheet.",
                "#element": "div",
                "@id": "room-/I/-override-row",
                "display": "none",
                "align-items": "center",
                "gap": "8px",
                "margin-top": "8px",
                "#": ["$OverrideText", "$OverrideCancel"],

                "$OverrideText": {
                    "#element": "div",
                    "@id": "room-/I/-override-text",
                    "flex": "1",
                    "min-width": "0",
                    "font-size": "12.5px",
                    "font-weight": "500",
                    "color": "var(--color-accent)"
                },
                "$OverrideCancel": {
                    "#element": "button",
                    "@id": "room-/I/-override-cancel",
                    "flex-shrink": "0",
                    "padding": "6px 10px",
                    "border": "1px solid var(--color-border-hairline)",
                    "border-radius": "9px",
                    "background": "var(--color-surface-card)",
                    "color": "var(--color-text-primary)",
                    "font-family": "inherit",
                    "font-size": "12px",
                    "font-weight": "500",
                    "cursor": "pointer",
                    "#content": "Cancel"
                }
            }
        }
    }
}

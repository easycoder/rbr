{
    "#doc": "Schedule period card — one entry in the room's periods[] array. /I/ replaced with the period index. Vertical stack: ON time dropdown, OFF time dropdown, target stepper; footer row with the Enabled checkbox and the delete button. Both times are native <select> lists, built once in schedule-editor.allspeak and attached per card, so a time is picked rather than stepped. When the period is switched off the three editable rows are dimmed and made inert (schedule-editor.allspeak sets opacity + pointer-events), leaving the checkbox and delete usable.",
    "#element": "div",
    "@id": "schedule-period-/I/",
    "padding": "14px 14px 12px 14px",
    "border-radius": "12px",
    "border": "1px solid var(--color-border-hairline)",
    "background": "var(--color-surface-card)",
    "position": "relative",
    "display": "flex",
    "flex-direction": "column",
    "gap": "10px",
    "#": ["$TimeRow", "$OffRow", "$TempRow", "$FooterRow"],

    "$TimeRow": {
        "#element": "div",
        "@id": "schedule-period-/I/-time-row",
        "display": "flex",
        "align-items": "center",
        "gap": "10px",
        "#": ["$TimeLabel", "$TimeSpacer", "$TimeSelect"],

        "$TimeLabel": {
            "#element": "div",
            "font-size": "12px",
            "font-weight": "500",
            "letter-spacing": "0.3px",
            "text-transform": "uppercase",
            "color": "var(--color-text-meta)",
            "#content": "On at"
        },
        "$TimeSpacer": { "#element": "div", "flex": "1" },
        "$TimeSelect": {
            "#element": "select",
            "@id": "schedule-period-/I/-start-select",
            "min-width": "112px",
            "padding": "7px 10px",
            "border-radius": "8px",
            "background": "var(--color-surface-card)",
            "border": "1px solid var(--color-border-hairline)",
            "cursor": "pointer",
            "font-family": "inherit",
            "font-size": "15px",
            "font-weight": "600",
            "font-variant-numeric": "tabular-nums",
            "color": "var(--color-text-primary)"
        }
    },

    "$OffRow": {
        "#element": "div",
        "@id": "schedule-period-/I/-off-row",
        "display": "flex",
        "align-items": "center",
        "gap": "10px",
        "#": ["$OffLabel", "$OffSpacer", "$OffSelect"],

        "$OffLabel": {
            "#element": "div",
            "font-size": "12px",
            "font-weight": "500",
            "letter-spacing": "0.3px",
            "text-transform": "uppercase",
            "color": "var(--color-text-meta)",
            "#content": "Off at"
        },
        "$OffSpacer": { "#element": "div", "flex": "1" },
        "$OffSelect": {
            "#element": "select",
            "@id": "schedule-period-/I/-off-select",
            "min-width": "112px",
            "padding": "7px 10px",
            "border-radius": "8px",
            "background": "var(--color-surface-card)",
            "border": "1px solid var(--color-border-hairline)",
            "cursor": "pointer",
            "font-family": "inherit",
            "font-size": "15px",
            "font-weight": "600",
            "font-variant-numeric": "tabular-nums",
            "color": "var(--color-text-primary)"
        }
    },

    "$TempRow": {
        "#element": "div",
        "@id": "schedule-period-/I/-temp-row",
        "display": "flex",
        "align-items": "center",
        "gap": "10px",
        "#": ["$TempLabel", "$TempSpacer", "$TempMinus", "$TempValue", "$TempPlus"],

        "$TempLabel": {
            "#element": "div",
            "font-size": "12px",
            "font-weight": "500",
            "letter-spacing": "0.3px",
            "text-transform": "uppercase",
            "color": "var(--color-text-meta)",
            "#content": "Target"
        },
        "$TempSpacer": { "#element": "div", "flex": "1" },
        "$TempMinus": {
            "#element": "button",
            "@id": "schedule-period-/I/-temp-minus",
            "width": "30px",
            "height": "30px",
            "padding": "0",
            "border-radius": "8px",
            "background": "transparent",
            "border": "1px solid var(--color-border-hairline)",
            "cursor": "pointer",
            "font-family": "inherit",
            "font-size": "16px",
            "font-weight": "600",
            "color": "var(--color-text-primary)",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "flex-shrink": "0",
            "#content": "−"
        },
        "$TempValue": {
            "#element": "div",
            "@id": "schedule-period-/I/-temp-value",
            "min-width": "60px",
            "text-align": "center",
            "font-size": "16px",
            "font-weight": "600",
            "font-variant-numeric": "tabular-nums",
            "color": "var(--color-text-primary)"
        },
        "$TempPlus": {
            "#element": "button",
            "@id": "schedule-period-/I/-temp-plus",
            "width": "30px",
            "height": "30px",
            "padding": "0",
            "border-radius": "8px",
            "background": "transparent",
            "border": "1px solid var(--color-border-hairline)",
            "cursor": "pointer",
            "font-family": "inherit",
            "font-size": "16px",
            "font-weight": "600",
            "color": "var(--color-text-primary)",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "flex-shrink": "0",
            "#content": "+"
        }
    },

    "$FooterRow": {
        "#element": "div",
        "display": "flex",
        "align-items": "center",
        "gap": "8px",
        "#": ["$EnableBox", "$EnableLabel", "$FooterSpacer", "$DeleteBtn"],

        "$EnableBox": {
            "#element": "input",
            "@id": "schedule-period-/I/-enable",
            "@type": "checkbox",
            "width": "18px",
            "height": "18px",
            "margin": "0",
            "flex-shrink": "0",
            "cursor": "pointer",
            "accent-color": "var(--color-accent)"
        },
        "$EnableLabel": {
            "#element": "label",
            "@for": "schedule-period-/I/-enable",
            "font-size": "12px",
            "font-weight": "500",
            "letter-spacing": "0.3px",
            "text-transform": "uppercase",
            "color": "var(--color-text-meta)",
            "cursor": "pointer",
            "#content": "Enabled"
        },
        "$FooterSpacer": { "#element": "div", "flex": "1" },
        "$DeleteBtn": {
            "#element": "button",
            "@id": "schedule-period-/I/-delete",
            "padding": "4px 10px",
            "border-radius": "6px",
            "background": "transparent",
            "border": "1px solid var(--color-border-hairline)",
            "cursor": "pointer",
            "font-family": "inherit",
            "font-size": "12px",
            "color": "#C8392E",
            "#content": "Delete period"
        }
    }
}

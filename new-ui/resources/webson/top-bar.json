{
    "#doc": "Room By Room — banner. One card inset from the page: the house mark, the system name, the heartbeat and the menu on the first row, then (on the simple home) the date and time, the Profile button and the outside temperature on a second row. The inset and rounded corners let the time-of-day gradient show around it.",
    "@id": "top-bar",
    "display": "flex",
    "flex-direction": "column",
    "gap": "10px",
    "margin": "8px 8px 0 8px",
    "padding": "12px 14px",
    "background": "rgba(255,255,255,0.96)",
    "backdrop-filter": "blur(16px)",
    "-webkit-backdrop-filter": "blur(16px)",
    "border": "1px solid rgba(18,52,90,0.08)",
    "border-radius": "18px",
    "box-shadow": "0 6px 18px rgba(18,52,90,0.10)",
    "position": "sticky",
    "top": "8px",
    "z-index": "10",
    "#": ["$Row", "$Info"],

    "$Row": {
        "#element": "div",
        "display": "flex",
        "align-items": "center",
        "gap": "12px",
        "#": ["$Mark", "$Text", "$Spacer", "$Heartbeat", "$MenuBtn"],

        "$Mark": {
            "#element": "button",
            "@id": "top-bar-mark",
            "@aria-label": "About Room By Room",
            "width": "38px",
            "height": "38px",
            "border-radius": "11px",
            "background": "transparent",
            "border": "0",
            "padding": "0",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "flex-shrink": "0",
            "cursor": "pointer",
            "#": "$Glyph",

            "$Glyph": {
                "#element": "img",
                "@src": "resources/icon/house.svg",
                "@alt": "",
                "width": "32px",
                "height": "32px",
                "pointer-events": "none"
            }
        },

        "$Text": {
            "#element": "div",
            "display": "flex",
            "flex-direction": "column",
            "line-height": "1.15",
            "#": ["$AppName", "$SystemId"],

            "$AppName": {
                "#element": "div",
                "@id": "top-bar-app-name",
                "font-size": "var(--type-app-name-size)",
                "font-weight": "var(--type-app-name-weight)",
                "letter-spacing": "var(--type-app-name-track)",
                "color": "var(--color-text-primary)",
                "#content": "Room By Room"
            },

            "$SystemId": {
                "#element": "div",
                "@id": "top-bar-system-id",
                "font-size": "13px",
                "font-weight": "500",
                "color": "var(--color-text-secondary)",
                "margin-top": "0"
            }
        },

        "$Spacer": {
            "#element": "div",
            "flex": "1"
        },

        "$Heartbeat": {
            "#doc": "Pulses on every map-request the UI sends to the controller, so a stalled poll loop (e.g. tab backgrounded by the OS) is visible at a glance. Tapping forces an immediate refresh — escape hatch when the loop has been throttled. The flame beside the dot appears while the demand relay is on; it is positioned outside the 24px button so showing it never moves the dot.",
            "#element": "button",
            "@id": "top-bar-heartbeat",
            "@aria-label": "Refresh now",
            "@title": "Tap to refresh",
            "width": "24px",
            "height": "24px",
            "padding": "0",
            "border": "0",
            "background": "transparent",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "position": "relative",
            "cursor": "pointer",
            "flex-shrink": "0",
            "#": ["$Flame", "$Dot"],

            "$Flame": {
                "#doc": "Demand relay on. Hidden on a system with no request relay configured, and while nothing is calling for heat. Positioned to the left of the dot, outside the button box, so the dot stays put.",
                "#element": "div",
                "@id": "top-bar-demand-flame",
                "@role": "img",
                "@aria-label": "Demand relay on",
                "position": "absolute",
                "top": "50%",
                "right": "20px",
                "transform": "translateY(-50%)",
                "width": "13px",
                "height": "13px",
                "background-color": "var(--color-accent)",
                "mask": "url(resources/icon/flame.svg) center/contain no-repeat",
                "-webkit-mask": "url(resources/icon/flame.svg) center/contain no-repeat",
                "visibility": "hidden",
                "pointer-events": "none"
            },

            "$Dot": {
                "#element": "div",
                "@id": "top-bar-heartbeat-dot",
                "width": "8px",
                "height": "8px",
                "border-radius": "50%",
                "background-color": "rgba(0,0,0,0.18)",
                "transition": "background-color 800ms ease-out",
                "pointer-events": "none"
            }
        },

        "$MenuBtn": {
            "#element": "button",
            "@id": "top-bar-menu-btn",
            "@aria-label": "Menu",
            "width": "38px",
            "height": "38px",
            "border-radius": "12px",
            "border": "0",
            "background": "rgba(18,52,90,0.05)",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "cursor": "pointer",
            "flex-shrink": "0",
            "position": "relative",
            "#": ["$HitArea", "$Glyph"],

            "$HitArea": {
                "#doc": "Invisible 44x44 expansion for touch — handoff requires ≥44px hit area.",
                "#element": "div",
                "position": "absolute",
                "top": "-3px",
                "left": "-3px",
                "right": "-3px",
                "bottom": "-3px",
                "pointer-events": "none"
            },

            "$Glyph": {
                "#element": "img",
                "@src": "resources/icon/hamburger.png",
                "@alt": "",
                "width": "18px",
                "height": "18px",
                "pointer-events": "none",
                "opacity": "0.72"
            }
        }
    },

    "$Info": {
        "#doc": "Second banner row, shown on the simple home only (the full view's summary card carries these). Date and time on the left, then the Profile button and the outside reading on the right. The outside half hides when no outdoor thermometer is configured; tapping the Profile button opens the profile editor.",
        "#element": "div",
        "@id": "top-bar-info",
        "display": "none",
        "align-items": "center",
        "gap": "10px",
        "padding-top": "10px",
        "border-top": "1px solid rgba(18,52,90,0.08)",
        "#": ["$Date", "$InfoSpacer", "$ProfileBtn", "$Outside"],

        "$Date": {
            "#element": "div",
            "@id": "top-bar-date",
            "font-size": "13px",
            "font-weight": "500",
            "letter-spacing": "0.1px",
            "color": "var(--color-text-secondary)",
            "white-space": "nowrap",
            "flex-shrink": "0"
        },

        "$InfoSpacer": {
            "#element": "div",
            "flex": "1"
        },

        "$ProfileBtn": {
            "#element": "button",
            "@id": "top-bar-profile",
            "@aria-label": "Profile and schedules",
            "box-sizing": "border-box",
            "max-width": "52%",
            "padding": "6px 13px 6px 10px",
            "border": "1px solid rgba(18,52,90,0.14)",
            "border-radius": "999px",
            "background": "var(--color-surface-card)",
            "display": "flex",
            "align-items": "center",
            "gap": "7px",
            "font-family": "inherit",
            "font-size": "14px",
            "font-weight": "600",
            "color": "var(--color-text-primary)",
            "cursor": "pointer",
            "flex-shrink": "0",
            "#": ["$ProfileCal", "$ProfileName"],

            "$ProfileCal": {
                "#element": "div",
                "width": "14px",
                "height": "14px",
                "background-color": "var(--color-text-secondary)",
                "mask": "url(resources/icon/calendar.svg) center/contain no-repeat",
                "-webkit-mask": "url(resources/icon/calendar.svg) center/contain no-repeat",
                "flex-shrink": "0"
            },

            "$ProfileName": {
                "#element": "div",
                "@id": "top-bar-profile-name",
                "min-width": "0",
                "overflow": "hidden",
                "text-overflow": "ellipsis",
                "white-space": "nowrap"
            }
        },

        "$Outside": {
            "#element": "div",
            "@id": "top-bar-outside-block",
            "display": "flex",
            "align-items": "baseline",
            "gap": "3px",
            "flex-shrink": "0",
            "#": ["$OutsideFrost", "$OutsideNumber", "$OutsideUnit"],

            "$OutsideFrost": {
                "#element": "div",
                "@id": "top-bar-outside-frost",
                "@role": "img",
                "@aria-label": "Frost protection active",
                "width": "14px",
                "height": "14px",
                "align-self": "center",
                "margin-right": "4px",
                "background-color": "var(--color-accent)",
                "mask": "url(resources/icon/snowflake.svg) center/contain no-repeat",
                "-webkit-mask": "url(resources/icon/snowflake.svg) center/contain no-repeat",
                "display": "none",
                "flex-shrink": "0"
            },

            "$OutsideNumber": {
                "#element": "span",
                "@id": "top-bar-outside",
                "font-size": "17px",
                "font-weight": "600",
                "letter-spacing": "-0.2px",
                "color": "var(--color-text-primary)",
                "white-space": "nowrap"
            },

            "$OutsideUnit": {
                "#element": "span",
                "font-size": "12px",
                "font-weight": "500",
                "color": "var(--color-text-muted)",
                "margin-left": "2px",
                "#content": "°C"
            }
        }
    }
}

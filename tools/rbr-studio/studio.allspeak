DeleterDone:
    put 0 into Deleting
    enable RunBtn
    enable ValidateBtn
    enable DemoBtn
    enable RefreshBtn
    enable RefreshScenariosBtn
    enable DraftBtn
    disable StopBtn
    disable DeleteScenarioBtn
    if the exit code of Deleter is 0
    begin
        append `Scenario removed; it is in fixtures/local/.trash.` to Log
        put `fixtures/local/scenarios/examples/advance-at-15-00.json` into ScenarioPath
        if file ScenarioPath does not exist put `docs/examples/advance.json` into ScenarioPath
        gosub to BuildScenarioList
        gosub to LoadScenario
        set the text of StatusLabel to `Scenario deleted`
    end
    else set the text of StatusLabel to `Delete failed`
    return
!! @hash
!! @verified c39cf26f
!!!

!! Create a group through the library helper; a group is a folder.
NewGroupClicked:
    if Running
    begin
        append `A run is in progress; stop it first.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it first.` to Log
        return
    end
    if Batching
    begin
        append `A batch is running; wait for it.` to Log
        return
    end
    create GroupDlg on Win type lineedit title `New group` prompt `Group name (one word)` value ``
    show GroupDlg
    put GroupDlg into GroupValue
    if GroupValue is empty return
    append `Creating group ` cat GroupValue to Log
    put 1 into Grouping
    start Grouper command `.venv/bin/python scenario_library.py group --name ` cat GroupValue
    set the text of StatusLabel to `Creating group…`
    return
!! @hash a7cc27f9
!! @verified a7cc27f9
!!!

GrouperLine:
    append the line of Grouper to Log
    return

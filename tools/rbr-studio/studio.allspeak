!! @hash
!! @verified 9f165528
!!!

!! Rebuild the scenario list: the local system, then the library, including the seeded Examples group.
!! `ExamplePaths` maps a list label to its file; `LibraryPaths` marks deletable library paths; Local system remains read-only.
BuildScenarioList:
    clear Scenarios
    put json `{}` into ExamplePaths
    put json `{}` into LibraryPaths
    put json `{}` into LibraryNames
    put json `{}` into BriefPaths
    put CurrentGroup into GroupName
    if GroupName is empty put `All` into GroupName
    if GroupName is `All` or GroupName is `Local`
    begin
        if file `fixtures/local/smoke.json` exists
        begin
            add `Local system` to Scenarios
            set entry `Local system` of ExamplePaths to `fixtures/local/smoke.json`
        end
    end
    gosub to LoadLibrary
    return
!! @hash 3141ddff
!! @verified f8fcc98c
!!!

!! Append the library manifest to the scenario list.
LoadLibrary:
    if file `fixtures/local/scenarios/index.json` exists
    begin
        load LibText from `fixtures/local/scenarios/index.json`
        put json LibText into LibData
        if LibData is not empty
        begin
            if LibData has entry `scenarios` put entry `scenarios` of LibData into LibList else put `[]` into LibList
            put the count of LibList into LibCount
            put 0 into LibI
            while LibI is less than LibCount
            begin
                put item LibI of LibList into LibEntry
                put entry `name` of LibEntry into LibName
                put entry `path` of LibEntry into LibRel
                put entry `group` of LibEntry into LibGroup
                put `fixtures/local/scenarios/` cat LibRel into LibFull
                put empty into LibBrief
                if LibEntry has entry `brief` put `fixtures/local/scenarios/` cat entry `brief` of LibEntry into LibBrief
                if ExamplePaths has entry LibName put LibName cat ` (local)` into LibName
                set entry LibName of LibraryNames to LibFull
                if GroupName is `All` or LibGroup is GroupName
                begin
                    add LibName to Scenarios
                    set entry LibName of ExamplePaths to LibFull
                    set entry LibFull of LibraryPaths to 1
                    if LibBrief is not empty set entry LibFull of BriefPaths to LibBrief
                end
                add 1 to LibI
            end
        end
    end
    return
!! @hash ebf2916d
!! @verified 1e17961b
!!!

!! Selecting a scenario loads its steps and replaces the table.
ScenarioPicked:
    put the current item in Scenarios into Name
    if Name is empty return
    if Running
    begin
        append `A run is in progress; stop it before switching scenario.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it before switching scenario.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed; wait for it.` to Log
        return
    end
    if ExamplePaths has entry Name
    begin
        put entry Name of ExamplePaths into ScenarioPath
        put Name into SelectedName
        put 0 into SelectedIsLibrary
        if LibraryNames has entry Name set SelectedIsLibrary
        put empty into DraftGroup
        put empty into PromptPath
        disable CopyPathBtn
            clear Log
        gosub to LoadScenario
        gosub to SetDeleteButton
    end
    return
!! @hash 9bfc8ab0
!! @verified e240cd6c
!!!

!! Delete selected rows from a library scenario.
!!
!! The table uses native ExtendedSelection, so the selection can contain one row or many; `the selection of` returns ascending row indexes. Rows are removed from the highest index first so earlier indexes stay valid. Public examples must be duplicated before their rows can be removed.
DeleteRowsClicked:
    put the selection of Steps into Selection
    if the count of Selection is 0 return
    if position of `fixtures/local/scenarios/` in ScenarioPath is -1
    begin
        append `Duplicate this scenario before editing its rows.` to Log
        return
    end
    put `Delete ` cat the count of Selection cat ` selected row(s)?` into RequestText
    create DeleteRowsDlg on Win type confirm title `Delete rows` prompt RequestText
    show DeleteRowsDlg
    if DeleteRowsDlg is false return
    put the count of Selection into DeletedCount
    load ScenarioText from ScenarioPath
    put json ScenarioText into ScenarioData
    put entry `steps` of ScenarioData into StepList
    put the count of Selection into DeleteRowCount
    put DeleteRowCount into DeleteRow
    while DeleteRow is greater than 0
    begin
        subtract 1 from DeleteRow
        put item DeleteRow of Selection into RemoveRow
        delete item RemoveRow of StepList
    end
    put 1 into NewStepNumber
    put 0 into RenumberIndex
    while RenumberIndex is less than the count of StepList
    begin
        put item RenumberIndex of StepList into RenumberStep
        put `s` cat NewStepNumber into RenumberId
        set entry `id` of RenumberStep to RenumberId
        add 1 to NewStepNumber
        add 1 to RenumberIndex
    end
    set entry `steps` of ScenarioData to StepList
    if ScenarioData has entry `clock`
    begin
        put entry `clock` of ScenarioData into ClockData
        if the count of StepList is greater than 0
        begin
            put item 0 of StepList into FirstStep
            if FirstStep has entry `at`
            begin
                put entry `at` of FirstStep into FirstAt
                if the length of FirstAt is greater than 10
                    set entry `start` of ClockData to FirstAt
                else
                begin
                    put entry `start` of ClockData into ClockStart
                    put left 11 of ClockStart into NewStart
                    put NewStart cat FirstAt into NewStart
                    if the length of FirstAt is less than 8 put NewStart cat `:00` into NewStart
                    put NewStart cat right 6 of ClockStart into NewStart
                    set entry `start` of ClockData to NewStart
                end
            end
        end
        set entry `clock` of ScenarioData to ClockData
    end
    save ScenarioData to ScenarioPath
    gosub to LoadScenario
    gosub to SetDeleteButton
    set the text of StatusLabel to `Deleted ` cat DeletedCount cat ` row(s)`
    return
!! @hash 96492828
!! @verified
!!!

!! Selecting a step fills the inspector from the parallel detail list.
StepSelected:
    put the selection of Steps into Selection
    if the count of Selection is greater than 0 enable DeleteRowsBtn
    else disable DeleteRowsBtn
    put the selected row of Steps into RowIndex
    if RowIndex is less than 0 return
    put item RowIndex of StepIds into StepId
    put item RowIndex of StepDetails into Detail
    put item RowIndex of StepSubs into Sub
    set the text of InspectorTitle to `STEP ` cat StepId
    set the text of InspectorSub to Sub
    set the text of Inspector to Detail
    return
!! @hash 9bbe0657
!! @verified bdd712f7
!!!

!! Start a run: clear the logs, mark the state, and hand the command to the
!! process domain. The runner's default --repo is the checkout containing it.
!!
!! Run is headless and as fast as the page allows. Demo uses the same start
!! path with --headed, a paced clock, a short pause after each step and
!! collapsed polls; the speed selector chooses scenario seconds per real
!! second (120 turns the three-hour gap into 90 seconds).
RunClicked:
    put empty into Pace
    gosub to StartRun
    return
!! @hash ef5c6419
!! @verified ef5c6419
!!!

!! Demo: a headed, paced run with the speed selector.
DemoClicked:
    put the current of SpeedBox into SpeedValue
    if SpeedValue is empty put `120` into SpeedValue
    put `--headed --collapse-polls --step-pause-ms 300 --end-pause-ms 5000 --speed ` cat SpeedValue into Pace
    gosub to StartRun
    return
!! @hash ab8052c7
!! @verified 482783d6
!!!

!! Shared start for Run and Demo.
StartRun:
    if Running
    begin
        append `A run is already in progress.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed.` to Log
        return
    end
    if Batching
    begin
        append `A batch is in progress; wait for it.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it first.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if ScenarioPath is empty return
    if file `.venv/bin/python` exists
    begin
        clear Log
        clear WireLog
        clear ConsoleLog
        clear ArtifactsLog
        if Pace is empty
        begin
            append `Run ` cat ScenarioPath to Log
            set the text of StatusLabel to `Running ` cat ScenarioPath
        end
        else
        begin
            append `Demo ` cat ScenarioPath cat ` at ` cat SpeedValue cat `×` to Log
            set the text of StatusLabel to `Demo ` cat ScenarioPath
        end
        disable RunBtn
        disable ValidateBtn
        disable DemoBtn
        disable RefreshBtn
        disable RefreshScenariosBtn
        disable DraftBtn
        disable DeleteScenarioBtn
        enable StopBtn
        put 1 into Running
        put `.venv/bin/python -m scenario_runner --scenario ` cat ScenarioPath cat ` --jsonl` into Command
        if Pace is not empty put Command cat ` ` cat Pace into Command
        start Runner command Command
    end
    else
    begin
        append `Runner venv missing: run the setup in tools/rbr-studio/README.md.` to Log
        set the text of StatusLabel to `Runner venv missing`
    end
    return
!! @hash daa94db2
!! @verified daa94db2
!!!

!! Validate without launching a browser.
ValidateClicked:
    if Running
    begin
        append `A run is already in progress.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed.` to Log
        return
    end
    if Batching
    begin
        append `A batch is in progress; wait for it.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it first.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if file `.venv/bin/python` exists
    begin
        clear Log
        clear WireLog
        clear ConsoleLog
        clear ArtifactsLog
        append `Validate ` cat ScenarioPath to Log
        set the text of StatusLabel to `Validating ` cat ScenarioPath
        disable RunBtn
        disable ValidateBtn
        disable DemoBtn
        disable RefreshBtn
        disable RefreshScenariosBtn
        disable DraftBtn
        disable DeleteScenarioBtn
        enable StopBtn
        put 1 into Running
        put `.venv/bin/python -m scenario_runner --scenario ` cat ScenarioPath cat ` --jsonl --validate-only` into Command
        start Runner command Command
    end
    else append `Runner venv missing.` to Log
    return
!! @hash 01209228
!! @verified 01209228
!!!

!! Refresh the local map: run snapshot-map.py, add the Local system scenario if
!! this is its first snapshot, and reload that scenario when it is selected.
RefreshClicked:
    if Running
    begin
        append `A run is in progress; stop it before refreshing the map.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it before refreshing the map.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if Refreshing return
    if file `map.json` exists
    begin
        append `Refreshing map.json…` to Log
        set the text of StatusLabel to `Refreshing map…`
        disable RunBtn
        disable ValidateBtn
        disable DemoBtn
        disable RefreshBtn
        disable RefreshScenariosBtn
        disable DraftBtn
        disable DeleteScenarioBtn
        put 1 into Refreshing
        start Refresher command `python3 snapshot-map.py`
    end
    else
    begin
        append `No map.json beside studio.allspeak; put the live map there.` to Log
        set the text of StatusLabel to `No map.json`
    end
    return
!! @hash 2b880350
!! @verified 2b880350
!!!

RefresherLine:
    append the line of Refresher to Log
    return
!! @hash
!! @verified 2b880350
!!!

RefresherError:
    append the stderr line of Refresher to Log with color `#B00020`
    return
!! @hash
!! @verified 2b880350
!!!

RefresherDone:
    put 0 into Refreshing
    enable RunBtn
    enable ValidateBtn
    enable DemoBtn
    enable RefreshBtn
    enable RefreshScenariosBtn
    enable DraftBtn
    gosub to SetDeleteButton
    if the exit code of Refresher is 0
    begin
        if file `fixtures/local/smoke.json` exists
        begin
            if ExamplePaths has entry `Local system`
            begin
                if ScenarioPath is `fixtures/local/smoke.json` gosub to LoadScenario
            end
            else
            begin
                append `Local system` to ExampleNames
                set entry `Local system` of ExamplePaths to `fixtures/local/smoke.json`
                add `Local system` to Scenarios
            end
        end
        set the text of StatusLabel to `Map refreshed`
    end
    else set the text of StatusLabel to `Map refresh failed`
    return
!! @hash
!! @verified 2b880350
!!!

!! Ask for a journal source, day and window, then import it into the library.
!!
!! The source may be a bundle, a raw day, a local journal root, or user@host:/journal-root. The actual import, conversion and library update are one Python helper (`journal_ingest.py`); this handler only gathers the three values and follows the helper's SCENARIO_PATH line. The helper uses the operating system's SSH client and key, so no SSH secret is stored in the Studio or in the controller's credentials file.
JournalClicked:
    if Running
    begin
        append `A run is in progress; stop it before importing a journal.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it before importing a journal.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed; wait for it.` to Log
        return
    end
    if Journaling return
    if file `.venv/bin/python` does not exist
    begin
        append `Runner venv missing: run the setup in tools/rbr-studio/README.md.` to Log
        return
    end
    create JournalSourceDlg on Win type lineedit title `Import journal` prompt `Bundle, .jsonl, local root, user@host, or user@host:/root` value JournalSource
    show JournalSourceDlg
    put JournalSourceDlg into JournalSource
    if JournalSource is empty return
    create JournalDayDlg on Win type lineedit title `Journal day` prompt `YYYY-MM-DD (blank when the source is a bundle)` value JournalDay
    show JournalDayDlg
    put JournalDayDlg into JournalDay
    create JournalRangeDlg on Win type lineedit title `Window` prompt `HH:MM-HH:MM (blank for the whole source)` value JournalRange
    show JournalRangeDlg
    put JournalRangeDlg into JournalRange
    put empty into JournalFrom
    put empty into JournalTo
    if JournalRange is not empty
    begin
        put the index of `-` in JournalRange into DotIdx
        if DotIdx is greater than 0
        begin
            put left DotIdx of JournalRange into JournalFrom
            increment DotIdx
            put from DotIdx of JournalRange into JournalTo
        end
    end
    put `.venv/bin/python journal_ingest.py --source "` cat JournalSource cat `"` into Command
    if JournalDay is not empty put Command cat ` --day ` cat JournalDay into Command
    if JournalFrom is not empty put Command cat ` --from ` cat JournalFrom into Command
    if JournalTo is not empty put Command cat ` --to ` cat JournalTo into Command
    if file `map.json` exists put Command cat ` --map map.json` into Command
    append `Import journal: ` cat JournalSource to Log
    set the text of StatusLabel to `Importing journal…`
    disable JournalBtn
    disable RunBtn
    disable ValidateBtn
    disable DemoBtn
    disable RefreshBtn
    disable RefreshScenariosBtn
    disable DeleteScenarioBtn
    put 1 into Journaling
    put empty into JournalPath
    start Journaler command Command
    return
!! @hash 4d8327e0
!!!
!! Track the helper's output and remember the scenario path it reports.
JournalerLine:
    put the line of Journaler into LineText
    append LineText to Log
    if left 14 of LineText is `SCENARIO_PATH=`
    begin
        put LineText into JournalPath
        replace `SCENARIO_PATH=` with `` in JournalPath
        put trim JournalPath into JournalPath
    end
    return
!! @hash 22646160
!!!
!! Show the helper's error output in the log.
JournalerError:
    append the stderr line of Journaler to Log with color `#B00020`
    return
!! @hash 2d8c2249
!!!
!! Re-enable the Studio and load the generated scenario when the import finishes.
JournalerDone:
    put 0 into Journaling
    enable JournalBtn
    enable RunBtn
    enable ValidateBtn
    enable DemoBtn
    enable RefreshBtn
    enable RefreshScenariosBtn
    gosub to SetDeleteButton
    if the exit code of Journaler is 0 and JournalPath is not empty
    begin
        gosub to BuildScenarioList
        if file JournalPath exists
        begin
            put JournalPath into ScenarioPath
            gosub to LoadScenario
            gosub to SetDeleteButton
            set the text of StatusLabel to `Journal imported: ` cat JournalPath
        end
        else set the text of StatusLabel to `Journal import finished but the scenario was not found`
    end
    else set the text of StatusLabel to `Journal import failed`
    return
!! @hash 905595c5
!!!

!! Open the brief editor. The native multiline dialog is the text area; OK
!! saves the text, Cancel keeps the previous brief.
EditBriefClicked:
    if Running
    begin
        append `A run is in progress; stop it before editing the brief.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it before editing the brief.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed; wait for it.` to Log
        return
    end
    create BriefDlg on Win type multiline title `Scenario brief` prompt `Write the scenario brief. OK saves; Cancel keeps the previous brief.` value Brief
    show BriefDlg
    put BriefDlg into Edited
    if Edited is not Brief
    begin
        put Edited into Brief
        put empty into PromptPath
        disable CopyPathBtn
        if Brief is empty set the text of BriefPreview to `No brief yet — Edit brief to write one.`
        else set the text of BriefPreview to `Brief ready — click Draft scenario.`
    end
    return
!! @hash 87eb2dd0
!! @verified 87eb2dd0
!!!

!! Rebuild the scenario list from the manifest; keep the loaded file if it still exists.
RefreshScenariosClicked:
    if Running
    begin
        append `A run is in progress; stop it first.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it first.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed; wait for it.` to Log
        return
    end
    put ScenarioPath into KeepPath
    gosub to BuildScenarioList
    if KeepPath is not empty
    begin
        if file KeepPath exists
        begin
            put KeepPath into ScenarioPath
            gosub to LoadScenario
        end
    end
    put 0 into SelectedIsLibrary
    if SelectedName is not empty
    begin
        if LibraryNames has entry SelectedName set SelectedIsLibrary
    end
    gosub to SetDeleteButton
    set the text of StatusLabel to `Scenarios refreshed`
    return
!! @hash 63fbb72e
!! @verified a91e8520
!!!

!! Enable Delete only for a real local-library scenario.
!!
!! LibraryPaths is rebuilt whenever the list is filtered by group, so relying on
!! it alone made a selected library scenario look undeletable after a refresh.
!! The selected path is the authority: if it exists and lies under the local
!! scenarios directory, it can be removed. LibraryPaths is kept as a secondary
!! signal for the normal case.
SetDeleteButton:
    disable DeleteScenarioBtn
    put 0 into DeleteAllowed
    if ScenarioPath is empty return
    if file ScenarioPath does not exist return
    if SelectedIsLibrary set DeleteAllowed
    else
    begin
        put position of `fixtures/local/scenarios/` in ScenarioPath into PathPos
        if LibraryPaths has entry ScenarioPath set DeleteAllowed
        else if PathPos is not less than 0 set DeleteAllowed
    end
    if DeleteAllowed enable DeleteScenarioBtn
    return
!! @hash 77ebcfca
!!!
!! Delete a library scenario after a confirmation popup; it moves to .trash.
DeleteScenarioClicked:
    if Running
    begin
        append `A run is in progress; stop it first.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it first.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is already in progress.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed; wait for it.` to Log
        return
    end
    if DeleteAllowed
    begin
        put `Move ` cat ScenarioPath cat ` to the trash?` into RequestText
        create DeleteConfirmDlg on Win type confirm title `Delete scenario` prompt RequestText
        show DeleteConfirmDlg
        put DeleteConfirmDlg into DeleteConfirmed
        if DeleteConfirmed is false
        begin
            set the text of StatusLabel to `Delete cancelled`
            return
        end
        put empty into PromptPath
        disable CopyPathBtn
        append `Deleting ` cat ScenarioPath to Log
        set the text of StatusLabel to `Deleting…`
        disable RunBtn
        disable ValidateBtn
        disable DemoBtn
        disable RefreshBtn
        disable RefreshScenariosBtn
        disable DraftBtn
        disable DeleteScenarioBtn
        enable StopBtn
        put 1 into Deleting
        start Deleter command `.venv/bin/python scenario_library.py remove --path ` cat ScenarioPath
    end
    else append `Only scenarios in the local library can be deleted.` to Log
    return
!! @hash 2899a4cc
!! @verified a10d392b
!!!

!! Duplicate or rename the selected scenario through the library helper.
!!
!! These are the first editing tools; row insertion, row deletion and cell editing will use the same right-hand Tools row. Duplicate copies the brief and keeps the new scenario in the selected real group; rename is limited to library scenarios so public examples are never altered.
DuplicateClicked:
    if Librarying return
    if ScenarioPath is empty return
    if Name is empty put `Scenario` into DuplicateName
    else put Name cat ` copy` into DuplicateName
    create DuplicateDlg on Win type lineedit title `Duplicate scenario` prompt `Name for the copy` value DuplicateName
    show DuplicateDlg
    put DuplicateDlg into DuplicateName
    if DuplicateName is empty return
    put `Duplicate` into LibraryAction
    put `.venv/bin/python scenario_library.py duplicate --path "` cat ScenarioPath cat `" --name "` cat DuplicateName cat `"` into Command
    if CurrentGroup is not empty
    begin
        if CurrentGroup is not `All`
        begin
            if CurrentGroup is not `Local` put Command cat ` --group "` cat CurrentGroup cat `"` into Command
        end
    end
    gosub to StartLibrary
    return

RenameClicked:
    if Librarying return
    if ScenarioPath is empty return
    if position of `fixtures/local/scenarios/` in ScenarioPath is -1
    begin
        append `Only library scenarios can be renamed; duplicate this one first.` to Log
        return
    end
    put Name into RenameName
    create RenameDlg on Win type lineedit title `Rename scenario` prompt `New name` value RenameName
    show RenameDlg
    put RenameDlg into RenameName
    if RenameName is empty return
    put `Rename` into LibraryAction
    put `.venv/bin/python scenario_library.py rename --path "` cat ScenarioPath cat `" --name "` cat RenameName cat `"` into Command
    gosub to StartLibrary
    return

StartLibrary:
    if Librarying return
    put 1 into Librarying
    put empty into LibraryPath
    disable DuplicateBtn
    disable RenameBtn
    disable DeleteScenarioBtn
    set the text of StatusLabel to LibraryAction cat `…`
    start Librarian command Command
    return

LibrarianLine:
    put the line of Librarian into LineText
    append LineText to Log
    if left 14 of LineText is `SCENARIO_PATH=`
    begin
        put LineText into LibraryPath
        replace `SCENARIO_PATH=` with `` in LibraryPath
    end
    return

LibrarianError:
    append the line of Librarian to Log
    return

LibrarianDone:
    put 0 into Librarying
    enable DuplicateBtn
    if the exit code of Librarian is 0
    begin
        gosub to LoadGroups
        gosub to BuildScenarioList
        if LibraryPath is not empty and file LibraryPath exists put LibraryPath into ScenarioPath
        gosub to LoadScenario
        gosub to SetDeleteButton
        set the text of StatusLabel to LibraryAction cat ` complete`
    end
    else
    begin
        append `Scenario edit failed.` to Log
        set the text of StatusLabel to `Scenario edit failed`
    end
    put empty into LibraryAction
    return
!! @hash d26f0a2f
!! @verified
!!!

!! Draft with the configured provider. The helper reads the brief on stdin,
!! writes its result to fixtures/local/drafts/last.json and prints its log.
DraftClicked:
    if Running
    begin
        append `A run is in progress; stop it first.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed; wait for it.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is already in progress.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    put Brief into RequestText
    if RequestText is empty
    begin
        append `Click Edit brief and write a brief first.` to Log
        return
    end
    if file `.venv/bin/python` exists
    begin
        append `Drafting with the configured provider…` to Log
        set the text of StatusLabel to `Drafting…`
        disable RunBtn
        disable ValidateBtn
        disable DemoBtn
        disable RefreshBtn
        disable RefreshScenariosBtn
        disable DeleteScenarioBtn
        disable DraftBtn
        disable CopyPathBtn
        enable StopBtn
        put 1 into Drafting
        put `.venv/bin/python ai-draft.py` into Command
        if ScenarioPath is not empty
        begin
            if file ScenarioPath exists put Command cat ` --scenario ` cat ScenarioPath into Command
        end
        if DraftGroup is not empty put Command cat ` --group ` cat DraftGroup into Command
        else if CurrentGroup is not empty
        begin
            if CurrentGroup is not `All`
            begin
                if CurrentGroup is not `Local` put Command cat ` --group ` cat CurrentGroup into Command
            end
        end
        start Drafter command Command
        write RequestText to Drafter
        write `__END__` to Drafter
    end
    else append `Runner venv missing: run the setup in tools/rbr-studio/README.md.` to Log
    return
!! @hash 940a3464
!! @verified 940a3464
!!!

!! Copy the path of the prompt written by the last Draft, using the
!! AllSpeak clipboard command.
CopyPathClicked:
    if PromptPath is empty
    begin
        append `No prompt path yet — click Draft scenario first.` to Log
        set the text of StatusLabel to `No prompt path`
        return
    end
    clipboard copy PromptPath
    append `Copied prompt path: ` cat PromptPath to Log
    set the text of StatusLabel to `Prompt path copied`
    return
!! @hash c39cf26f
!! @verified c39cf26f
!!!

DrafterLine:
    append the line of Drafter to Log
    return
!! @hash
!! @verified c39cf26f
!!!

DrafterError:
    append the stderr line of Drafter to Log with color `#B00020`
    return
!! @hash
!! @verified c39cf26f
!!!

DrafterDone:
    put 0 into Drafting
    enable RunBtn
    enable ValidateBtn
    enable DemoBtn
    enable RefreshBtn
    enable RefreshScenariosBtn
    enable DraftBtn
    disable StopBtn
    put empty into LastStatus
    if file `fixtures/local/drafts/last.json` exists
    begin
        load LastText from `fixtures/local/drafts/last.json`
        put json LastText into LastData
        if LastData is not empty
        begin
            put entry `status` of LastData into LastStatus
            if LastStatus is `prompt`
            begin
                put entry `prompt` of LastData into LastPath
                put LastPath into PromptPath
                enable CopyPathBtn
                append `Brief saved: ` cat LastPath to Log
                append `Give it to Reasonix Studio or another AI, save the reply, then use --check or Refresh scenarios.` to Log
                set the text of StatusLabel to `Brief saved`
            end
            else if LastStatus is `ok`
            begin
                put empty into PromptPath
                disable CopyPathBtn
                put entry `path` of LastData into LastPath
                if LastData has entry `diff` append `Diff: ` cat entry `diff` of LastData to Log
                gosub to LoadGroups
                gosub to BuildScenarioList
                if DraftGroup is not empty append `Draft saved in group ` cat DraftGroup to Log
                put LastPath into ScenarioPath
                gosub to LoadScenario
                gosub to SetDeleteButton
                set the text of StatusLabel to `Draft loaded`
            end
            else if LastStatus is `error`
            begin
                put entry `message` of LastData into LastMessage
                append `Draft rejected: ` cat LastMessage to Log with color `#B00020`
                if LastData has entry `draft` append `Draft kept at ` cat entry `draft` of LastData to Log
                set the text of StatusLabel to `Draft rejected`
            end
            else set the text of StatusLabel to `Draft stopped`
        end
    end
    if LastStatus is empty set the text of StatusLabel to `Draft failed; see the log`
    if PromptPath is empty disable CopyPathBtn else enable CopyPathBtn
    gosub to SetDeleteButton
    return
!! @hash

!! @verified a7cc27f9
!!!

GrouperError:
    append the stderr line of Grouper to Log with color `#B00020`
    return
!! @hash
!! @verified a7cc27f9
!!!

GrouperDone:
    put 0 into Grouping
    if the exit code of Grouper is 0
    begin
        gosub to LoadGroups
        gosub to BuildScenarioList
        set the text of StatusLabel to `Group created — choose it in the group selector`
    end
    else set the text of StatusLabel to `Group creation failed`
    return
!! @hash
!! @verified a7cc27f9
!!!

!! Build a batch by adding the selected scenario to the batch list.
AddBatchClicked:
    if ScenarioPath is empty
    begin
        append `Select a scenario before adding it to the batch.` to Log
        return
    end
    put the current item in Scenarios into BatchName
    if BatchName is empty put ScenarioPath into BatchName
    put 0 into BatchI
    while BatchI is less than the count of BatchPaths
    begin
        if item BatchI of BatchPaths is ScenarioPath
        begin
            append `Already in the batch: ` cat BatchName to Log
            return
        end
        add 1 to BatchI
    end
    append ScenarioPath to BatchPaths
    append BatchName to BatchNames
    add BatchName to BatchList
    append `Batch + ` cat BatchName to Log
    set the text of StatusLabel to `Batch: ` cat the count of BatchPaths cat ` scenarios`
    return
!! @hash 53459387
!! @verified 53459387
!!!

RemoveBatchClicked:
    put the current item in BatchList into BatchName
    if BatchName is empty
    begin
        append `Select a batch entry to remove.` to Log
        return
    end
    put -1 into BatchI
    put 0 into BatchCount
    while BatchCount is less than the count of BatchNames
    begin
        if item BatchCount of BatchNames is BatchName put BatchCount into BatchI
        add 1 to BatchCount
    end
    if BatchI is less than 0
    begin
        append `No such batch entry: ` cat BatchName to Log
        return
    end
    delete item BatchI of BatchNames
    delete item BatchI of BatchPaths
    clear BatchList
    put 0 into BatchI
    while BatchI is less than the count of BatchNames
    begin
        add item BatchI of BatchNames to BatchList
        add 1 to BatchI
    end
    append `Batch - ` cat BatchName to Log
    set the text of StatusLabel to `Batch: ` cat the count of BatchPaths cat ` scenarios`
    return
!! @hash
!! @verified 53459387
!!!

!! Run every scenario in the batch, in order, through batch_runner.py.
RunBatchClicked:
    if Running
    begin
        append `A run is in progress; stop it first.` to Log
        return
    end
    if Batching
    begin
        append `A batch is already running.` to Log
        return
    end
    if Drafting
    begin
        append `A draft is in progress; stop it first.` to Log
        return
    end
    if Deleting
    begin
        append `A delete is in progress; wait for it.` to Log
        return
    end
    if Refreshing
    begin
        append `The map is being refreshed; wait for it.` to Log
        return
    end
    put the count of BatchPaths into BatchCount
    if BatchCount is 0
    begin
        append `The batch is empty; add a scenario first.` to Log
        return
    end
    put `.venv/bin/python batch_runner.py` into Command
    put 0 into BatchI
    while BatchI is less than BatchCount
    begin
        put Command cat ` --scenario ` cat item BatchI of BatchPaths into Command
        add 1 to BatchI
    end
    append `Running batch of ` cat BatchCount cat ` scenarios…` to Log
    set the text of StatusLabel to `Batch running…`
    disable RunBtn
    disable ValidateBtn
    disable DemoBtn
    disable RefreshBtn
    disable RefreshScenariosBtn
    disable NewScenarioBtn
    disable EditBriefBtn
    disable DraftBtn
    disable DeleteScenarioBtn
    disable Scenarios
    disable GroupBox
    disable AddBatchBtn
    disable RemoveBatchBtn
    disable RunBatchBtn
    enable StopBtn
    put 1 into Batching
    start Batcher command Command
    return
!! @hash 2c9eb0c3

    enable DemoBtn
    enable RefreshBtn
    enable RefreshScenariosBtn
    enable NewScenarioBtn
    enable EditBriefBtn
    enable DraftBtn
    enable Scenarios
    enable GroupBox
    enable AddBatchBtn
    enable RemoveBatchBtn
    enable RunBatchBtn
    gosub to SetDeleteButton

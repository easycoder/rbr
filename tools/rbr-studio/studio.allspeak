!   RBR Studio — the desktop shell.
!!
!! An AllSpeak/PySide6 window, built from the graphics domain's own table,
!! logpane, panes and tabs. The Run button starts scenario_runner as a child
!! process and its JSONL events drive the result column and the log, while the
!! AllSpeak flow sits in Idle. Nothing polls the child.
!!
!! Run from this directory, because the example paths and the runner's venv
!! are relative to it:
!!
!!     cd tools/rbr-studio
!!     allspeak studio.allspeak
!!
!! The runner is the v0 engine in scenario_runner/; its venv is .venv.
!! @hash
!! @verified
!!!
script RBRStudio

use graphics
use process

window Win
layout Root
panel Toolbar
layout ToolbarRow
label Brand
label Env
label Clock
pushbutton ValidateBtn
pushbutton StopBtn
pushbutton RunBtn
pushbutton DemoBtn
pushbutton QuitBtn
pushbutton RefreshBtn
label SpeedLabel
combobox SpeedBox

panes Work
panes Vert
panel Sidebar
layout SidebarCol
layout DraftRow
layout ToolsRow
label GroupLabel
combobox GroupBox
pushbutton NewScenarioBtn
pushbutton NewGroupBtn
dialog GroupDlg
label BatchLabel
listbox BatchList
pushbutton AddBatchBtn
pushbutton RemoveBatchBtn
pushbutton RunBatchBtn
label ScenariosLabel
listbox Scenarios
pushbutton JournalBtn
label BriefPreview
pushbutton EditBriefBtn
dialog BriefDlg
dialog NewScenarioGroupDlg
dialog DuplicateDlg
dialog RenameDlg
dialog DeleteRowsDlg
dialog DeleteConfirmDlg
dialog JournalSourceDlg
dialog JournalDayDlg
dialog JournalRangeDlg
label AiLabel
pushbutton DraftBtn
pushbutton CopyPathBtn
pushbutton RefreshScenariosBtn
pushbutton DeleteScenarioBtn
pushbutton DuplicateBtn
pushbutton RenameBtn
pushbutton DeleteRowsBtn

panel Editor
layout EditorCol
label Title
label Meta
table Steps

panel InspectorPane
layout InspectorCol
label InspectorTitle
label InspectorSub
multiline Inspector

tabs LogTabs
logpane Log
logpane WireLog
logpane ConsoleLog
logpane ArtifactsLog
label StatusLabel

process Runner
process Refresher
process Drafter
process Deleter
process Batcher
process Grouper
process Journaler
process Librarian

variable ScenarioPath
variable Brief
variable PromptPath
variable Edited
variable Command
variable Running
variable Pace
variable SpeedValue
variable Refreshing
variable Drafting
variable Deleting
variable Batching
variable BatchName
variable BatchCount
variable BatchI
variable GroupValue
variable Grouping
variable DraftGroup
variable DeleteConfirmed
variable DuplicateName
variable RenameName
variable Librarying
variable LibraryAction
variable LibraryPath
list Selection
variable RemoveRow
variable DeleteRow
variable DeleteRowCount
variable DeletedCount
variable RenumberIndex
variable NewStepNumber
variable RenumberId
variable ClockStart
variable NewStart
variable Journaling
variable JournalSource
variable JournalDay
variable JournalRange
variable JournalFrom
variable JournalTo
variable JournalPath
variable DeleteAllowed
variable SelectedIsLibrary
variable SelectedName
variable PathPos
variable DotIdx
variable RequestText
variable LastText
variable LastStatus
variable LastPath
variable LastMessage
variable LibText
variable LibName
variable LibRel
variable LibFull
variable LibCount
variable LibI
variable KeepPath
variable CurrentGroup
variable GroupName
variable BriefRel
variable LibGroup
variable LibBrief
list LibGroups
variable LibGroupCount
variable LibGroupI
variable ScenarioText
dictionary ScenarioData
dictionary ClockData
dictionary FirstStep
dictionary RenumberStep
list StepList
dictionary Step
dictionary Controller
dictionary State
dictionary Fields
dictionary UI
dictionary Expect
dictionary Wire
variable LineText
dictionary Event
dictionary RoomAliases
dictionary LibraryPaths
dictionary LibraryNames
dictionary BriefPaths
dictionary LastData
dictionary LibData
list LibList
dictionary LibEntry
list BatchPaths
list BatchNames
variable Kind
variable Id
variable At
variable AtShort
variable Actor
variable ActorLabel
variable Target
variable Action
variable Expectation
variable Detail
variable Sub
variable RowIndex
variable Count
variable StepId
variable RunStatus
variable Passed
variable Failed
variable Name
variable ExitCode
variable Message
variable Source
variable FirstAt
variable LastAt
variable ProfileName
dictionary HomeSpec
dictionary Artifacts

list Rows
list RowValues
list StepIds
list StepDetails
list StepSubs
list ActorTokens
list ExampleNames
dictionary ExamplePaths
dictionary StudioSettings
variable SettingsText
variable SavedGroup
variable SavedScenario
variable SavedSSH
variable SavedDay
variable SavedRange
variable WindowX
variable WindowY
variable WindowW
variable WindowH

!! Build the window and load the first scenario.
!!
!! The layout is the mockup's four regions: a toolbar, three side-by-side
!! panes, and the log tabs below them. The table is seeded from the scenario
!! JSON; the process handlers are registered before Run can start anything.
!!
!! A startup scan of the mail-filter folder adds any emailed journal bundle to the Journal group before the list is built, so a day the controller posted overnight is present when the window opens.
Setup:
    init graphics

    gosub to LoadStudioSettings
    create Win title `RBR Studio` at WindowX WindowY size WindowW WindowH
    create Root type QVBoxLayout
    create Toolbar
    create ToolbarRow type QHBoxLayout
    set the layout of Toolbar to ToolbarRow

    create Brand text `RBR Studio` size 18
    create Env text `rbr · new-ui · 390 × 844` size 28
    create Clock text `clock —` size 18
    create SpeedLabel text `Speed` size 8
    create SpeedBox
    add `120` to SpeedBox
    add `300` to SpeedBox
    add `60` to SpeedBox
    add `1` to SpeedBox
    create ValidateBtn text `Validate` size 10
    create StopBtn text `Stop` size 10
    create RunBtn text `▶ Run` size 10
    create DemoBtn text `Demo` size 10
    create QuitBtn text `Quit` size 10
    create RefreshBtn text `Refresh map` size 12

    set the style of Brand to `font-size:15px;font-weight:600;`
    set the color of Env to `#666666`
    set the color of Clock to `#666666`
    set the color of SpeedLabel to `#666666`
    disable StopBtn

    add Brand to ToolbarRow
    add spacer size 12 to ToolbarRow
    add Env to ToolbarRow
    add stretch to ToolbarRow
    add SpeedLabel to ToolbarRow
    add SpeedBox to ToolbarRow
    add Clock to ToolbarRow
    add RefreshBtn to ToolbarRow
    add ValidateBtn to ToolbarRow
    add StopBtn to ToolbarRow
    add RunBtn to ToolbarRow
    add DemoBtn to ToolbarRow
    add QuitBtn to ToolbarRow
    add spacer size 12 to ToolbarRow
    add Toolbar to Root

    create Work orientation horizontal
    create Vert orientation vertical

    create Sidebar
    create SidebarCol type QVBoxLayout
    set the layout of Sidebar to SidebarCol
    create GroupLabel text `GROUP` size 12
    create GroupBox
    create NewScenarioBtn text `New scenario` size 12
    create NewGroupBtn text `New group` size 12
    create ScenariosLabel text `SCENARIOS` size 14
    create Scenarios
    set the height of Scenarios to 150
    create JournalBtn text `Import journal…` size 10
    create AiLabel text `DRAFT WITH AI` size 14
    put `Advance in the office at 15:00, expect the button to say Cancel the advance, then the controller clears it at 18:00.` into Brief
    create BriefPreview text `Brief ready — Edit brief to change it.` size 28
    create EditBriefBtn text `Edit brief…` size 12
    create DraftBtn text `Draft scenario` size 10
    create CopyPathBtn text `Copy path` size 12
    disable CopyPathBtn
    create DraftRow type QHBoxLayout
    add DraftBtn to DraftRow
    add CopyPathBtn to DraftRow
    create BatchLabel text `BATCH` size 12
    create BatchList
    set the height of BatchList to 60
    create AddBatchBtn text `+ Batch` size 10
    create RemoveBatchBtn text `- Batch` size 12
    create RunBatchBtn text `Run batch` size 12
    create RefreshScenariosBtn text `↻ Scenarios` size 10
    create DeleteScenarioBtn text `Delete scenario` size 12
    disable DeleteScenarioBtn
    set the style of GroupLabel to `font-size:9px;font-weight:700;color:#999999;`
    set the style of BatchLabel to `font-size:9px;font-weight:700;color:#999999;`
    set the style of ScenariosLabel to `font-size:9px;font-weight:700;color:#999999;`
    set the style of AiLabel to `font-size:9px;font-weight:700;color:#999999;`
    set the color of BriefPreview to `#666666`
    add GroupLabel to SidebarCol
    add GroupBox to SidebarCol
    add NewGroupBtn to SidebarCol
    add NewScenarioBtn to SidebarCol
    add ScenariosLabel to SidebarCol
    add Scenarios to SidebarCol
    add JournalBtn to SidebarCol
    add RefreshScenariosBtn to SidebarCol
    add DeleteScenarioBtn to SidebarCol
    add spacer size 10 to SidebarCol
    add AiLabel to SidebarCol
    add BriefPreview to SidebarCol
    add EditBriefBtn to SidebarCol
    add DraftRow to SidebarCol
    add spacer size 10 to SidebarCol
    add BatchLabel to SidebarCol
    add BatchList to SidebarCol
    add AddBatchBtn to SidebarCol
    add RemoveBatchBtn to SidebarCol
    add RunBatchBtn to SidebarCol
    add stretch to SidebarCol
    add Sidebar to Work

    create Editor
    create EditorCol type QVBoxLayout
    set the layout of Editor to EditorCol
    create Title text `Loading…` size 60
    create Meta text `` size 40
    create Steps
    set the style of Title to `font-size:16px;font-weight:600;`
    set the color of Meta to `#666666`
    set columns of Steps to `["#","Time","Actor","Target","Action","Expectation","Result"]`
    set selection of Steps to multiple
    set column widths of Steps to `[32,55,95,150,220,220,40]`
    set stretch column of Steps to 5
    add Title to EditorCol
    add Meta to EditorCol
    add stretch Steps to EditorCol
    add Editor to Work

    create InspectorPane
    create InspectorCol type QVBoxLayout
    set the layout of InspectorPane to InspectorCol
    create InspectorTitle text `STEP —` size 14
    create InspectorSub text `` size 20
    create Inspector readonly cols 36 rows 20
    create ToolsRow type QHBoxLayout
    create DuplicateBtn text `Duplicate…` size 10
    create RenameBtn text `Rename…` size 10
    create DeleteRowsBtn text `Delete rows` size 10
    disable RenameBtn
    disable DeleteRowsBtn
    set the style of InspectorTitle to `font-size:12px;font-weight:600;`
    set the color of InspectorSub to `#666666`
    add InspectorTitle to InspectorCol
    add InspectorSub to InspectorCol
    add DuplicateBtn to ToolsRow
    add RenameBtn to ToolsRow
    add DeleteRowsBtn to ToolsRow
    add ToolsRow to InspectorCol
    add stretch Inspector to InspectorCol
    add InspectorPane to Work

    set sizes of Work to `[230,820,310]`

    create LogTabs
    create Log
    create WireLog
    create ConsoleLog
    create ArtifactsLog
    add Log to LogTabs as `Steps`
    add WireLog to LogTabs as `Wire`
    add ConsoleLog to LogTabs as `Console`
    add ArtifactsLog to LogTabs as `Artifacts`
    set current tab of LogTabs to 0
    add Work to Vert
    add LogTabs to Vert
    set sizes of Vert to `[590,190]`
    add Vert to Root

    create StatusLabel text `Ready` size 80
    set the background color of StatusLabel to `#FDF0EA`
    set the color of StatusLabel to `#8C4A2E`
    add StatusLabel to Root
    set the layout of Win to Root

    on click RunBtn go to RunClicked
    on click DemoBtn go to DemoClicked
    on click RefreshBtn go to RefreshClicked
    on click ValidateBtn go to ValidateClicked
    on click StopBtn go to StopClicked
    on select GroupBox go to GroupChanged
    on click NewGroupBtn go to NewGroupClicked
    on click NewScenarioBtn go to NewScenarioClicked
    on click AddBatchBtn go to AddBatchClicked
    on click RemoveBatchBtn go to RemoveBatchClicked
    on click RunBatchBtn go to RunBatchClicked
    on line Grouper go to GrouperLine
    on stderr line Grouper go to GrouperError
    on exit Grouper go to GrouperDone
    on line Batcher go to BatcherLine
    on stderr line Batcher go to BatcherError
    on exit Batcher go to BatcherDone
    on click EditBriefBtn go to EditBriefClicked
    on click CopyPathBtn go to CopyPathClicked
    on click DraftBtn go to DraftClicked
    on click RefreshScenariosBtn go to RefreshScenariosClicked
    on click DeleteScenarioBtn go to DeleteScenarioClicked
    on click JournalBtn go to JournalClicked
    on click DuplicateBtn go to DuplicateClicked
    on click RenameBtn go to RenameClicked
    on click DeleteRowsBtn go to DeleteRowsClicked
    on click QuitBtn go to QuitClicked
    on select Scenarios go to ScenarioPicked
    on select Steps go to StepSelected
    on close Win go to WinClosed
    on line Runner go to RunnerLine
    on stderr line Runner go to RunnerError
    on exit Runner go to RunnerDone
    on line Refresher go to RefresherLine
    on stderr line Refresher go to RefresherError
    on exit Refresher go to RefresherDone
    on line Drafter go to DrafterLine
    on stderr line Drafter go to DrafterError
    on exit Drafter go to DrafterDone
    on line Deleter go to DeleterLine
    on stderr line Deleter go to DeleterError
    on exit Deleter go to DeleterDone
    on line Journaler go to JournalerLine
    on stderr line Journaler go to JournalerError
    on exit Journaler go to JournalerDone
    on line Librarian go to LibrarianLine
    on stderr line Librarian go to LibrarianError
    on exit Librarian go to LibrarianDone

    system `python3 scenario_library.py seed-examples --quiet`
    system `python3 journal_inbox.py --scan --quiet`
    gosub to LoadGroups
    gosub to RestoreStudioSettings
    gosub to BuildScenarioList
    gosub to LoadScenario

    show Win
    put 0 into Running
    put 0 into Drafting
    put 0 into Deleting
    put 0 into Journaling
    put 0 into Refreshing
    put empty into JournalPath
    put 0 into Grouping
    put 0 into Librarying
    put empty into LibraryAction
    put empty into LibraryPath
    set the text of StatusLabel to `Ready — Run starts the runner.`
Idle:
    wait 1 tick
    go to Idle
!! @hash 222c8394
!! @verified 222c8394
!!!

!! Restore the Studio's last window geometry and form values.
!!
!! The settings file is machine-local and deliberately separate from the scenario library; a missing or invalid file falls back to the defaults.
LoadStudioSettings:
    put 40 into WindowX
    put 40 into WindowY
    put 1360 into WindowW
    put 800 into WindowH
    put empty into SavedGroup
    put empty into SavedScenario
    put empty into SavedSSH
    put empty into SavedDay
    put empty into SavedRange
    if file `fixtures/local/studio-settings.json` exists
    begin
        load SettingsText from `fixtures/local/studio-settings.json`
        put json SettingsText into StudioSettings
        if StudioSettings has entry `x` put entry `x` of StudioSettings into WindowX
        if StudioSettings has entry `y` put entry `y` of StudioSettings into WindowY
        if StudioSettings has entry `width` put entry `width` of StudioSettings into WindowW
        if StudioSettings has entry `height` put entry `height` of StudioSettings into WindowH
        if StudioSettings has entry `group` put entry `group` of StudioSettings into SavedGroup
        if StudioSettings has entry `scenario` put entry `scenario` of StudioSettings into SavedScenario
        if StudioSettings has entry `ssh` put entry `ssh` of StudioSettings into SavedSSH
        if StudioSettings has entry `day` put entry `day` of StudioSettings into SavedDay
        if StudioSettings has entry `range` put entry `range` of StudioSettings into SavedRange
    end
    return
!! @hash a8cbb1b1
!! @verified
!!!

!! Restore the saved group, scenario and journal prompts after the lists exist.
!!
!! A deleted group or scenario falls back to All and the seeded Advance example; the saved values only seed the dialogs, so they never start a request by themselves.
RestoreStudioSettings:
    if SavedGroup is not empty
    begin
        select SavedGroup in GroupBox
        put GroupBox into CurrentGroup
    end
    if SavedScenario is not empty
    begin
        if file SavedScenario exists put SavedScenario into ScenarioPath
    end
    if ScenarioPath is empty
    begin
        put `fixtures/local/scenarios/examples/advance-at-15-00.json` into ScenarioPath
        if file ScenarioPath does not exist put `docs/examples/advance.json` into ScenarioPath
    end
    if SavedSSH is not empty put SavedSSH into JournalSource
    if SavedDay is not empty put SavedDay into JournalDay
    if SavedRange is not empty put SavedRange into JournalRange
    return
!! @hash 76f9bd5d
!! @verified
!!!

!! Load the scenario file and seed the table from its steps.
!!
!! Each row is an array in column order, because the table's readback and
!! `set cell` are simplest with arrays. Step details for the inspector, step
!! ids for the runner's events and the actor token for the cell colour are kept
!! in parallel lists — the table is read-only, the inspector is the editor.
LoadScenario:
    load ScenarioText from ScenarioPath
    put json ScenarioText into ScenarioData
    if ScenarioData is empty
    begin
        set the text of StatusLabel to `Could not load ` cat ScenarioPath
        return
    end
    put entry `name` of ScenarioData into Name
    put entry `steps` of ScenarioData into StepList
    put entry `home` of ScenarioData into HomeSpec
    put json `{}` into RoomAliases
    if ScenarioData has entry `rooms` put entry `rooms` of ScenarioData into RoomAliases
    put empty into Brief
    if BriefPaths has entry ScenarioPath
    begin
        put entry ScenarioPath of BriefPaths into BriefRel
        if file BriefRel exists load Brief from BriefRel
    end
    if Brief is empty
    begin
        if ScenarioData has entry `description` put entry `description` of ScenarioData into Brief
    end
    if Brief is empty set the text of BriefPreview to `No brief yet — Edit brief to write one.`
    else set the text of BriefPreview to `Brief ready — click Draft scenario.`
    put `active profile` into ProfileName
    if HomeSpec has entry `profile` put entry `profile` of HomeSpec into ProfileName
    reset Selection
    disable DeleteRowsBtn
    put `[]` into Rows
    put `[]` into StepIds
    put `[]` into StepDetails
    put `[]` into StepSubs
    put `[]` into ActorTokens
    put empty into FirstAt
    put empty into LastAt
    put 0 into RowIndex
    put the count of StepList into Count
    while RowIndex is less than Count
    begin
        put item RowIndex of StepList into Step
        gosub to DescribeStep
        put `[]` into RowValues
        append Id to RowValues
        append AtShort to RowValues
        append ActorLabel to RowValues
        append Target to RowValues
        append Action to RowValues
        append Expectation to RowValues
        append `○` to RowValues
        append RowValues to Rows
        append Id to StepIds
        append Actor to ActorTokens
        append Detail to StepDetails
        append ActorLabel cat ` · ` cat AtShort to StepSubs
        if FirstAt is empty put AtShort into FirstAt
        put AtShort into LastAt
        increment RowIndex
    end
    set rows of Steps to Rows
    gosub to PaintRows
    set the text of Title to Name
    set the text of Meta to ProfileName cat ` · ` cat Count cat ` steps · virtual clock`
    set the text of Clock to `clock ` cat FirstAt cat ` → ` cat LastAt
    if Count is greater than 0
    begin
        put item 0 of StepIds into StepId
        put item 0 of StepDetails into Detail
        put item 0 of StepSubs into Sub
        set the text of InspectorTitle to `STEP ` cat StepId
        set the text of InspectorSub to Sub
        set the text of Inspector to Detail
    end
    else
    begin
        set the text of InspectorTitle to `STEP —`
        set the text of InspectorSub to ``
        set the text of Inspector to `Select a step to inspect it.`
    end
    if ScenarioPath is not empty enable DuplicateBtn
    else disable DuplicateBtn
    if position of `fixtures/local/scenarios/` in ScenarioPath is greater than -1 enable RenameBtn
    else disable RenameBtn
    set the text of StatusLabel to `Loaded ` cat ScenarioPath
    return
!! @hash 47fcd2bb
!! @verified 6cd54bc1
!!!

!! Turn one step into the table's six display cells and the inspector line.
!!
!! This mirrors the runner's own summary in Python, but only for the fields
!! the examples use. Unknown shapes fall back to the actor and target, which is
!! enough to see that a step exists; the raw JSON is in the runner's wire log.
DescribeStep:
    put entry `id` of Step into Id
    put entry `at` of Step into At
    put At into AtShort
    if the length of At is greater than 18 put from 11 to 19 of At into AtShort
    put empty into Target
    put empty into Action
    put empty into Expectation
    put empty into Detail
    if Step has entry `controller`
    begin
        put `controller` into Actor
        put `Controller` into ActorLabel
        put entry `controller` of Step into Controller
        put entry `room` of Controller into Target
        put empty into Action
        if Controller has entry `set`
        begin
            put entry `set` of Controller into Fields
            if Fields has entry `temperature`
            begin
                if Action is not empty put Action cat `; ` into Action
                put Action cat `temperature = ` cat entry `temperature` of Fields into Action
            end
            if Fields has entry `relay`
            begin
                if Action is not empty put Action cat `; ` into Action
                put Action cat `relay = ` cat entry `relay` of Fields into Action
            end
            if Fields has entry `advance`
            begin
                if Action is not empty put Action cat `; ` into Action
                put Action cat `advance = ` cat entry `advance` of Fields into Action
            end
        end
        if Controller has entry `state`
        begin
            put entry `state` of Controller into State
            if State has entry `set`
            begin
                put entry `set` of State into Fields
                if Fields has entry `advance`
                begin
                    if Action is not empty put Action cat `; ` into Action
                    put Action cat `advance = ` cat entry `advance` of Fields into Action
                end
            end
        end
        if Controller has entry `raw` put `raw payload` into Action
        if Action is empty put `push` into Action
        put Action cat ` · push` into Action
        put `—` into Expectation
    end
    else if Step has entry `ui`
    begin
        put `ui` into Actor
        put `UI` into ActorLabel
        put entry `ui` of Step into UI
        put `—` into Expectation
        if UI has entry `tap` put entry `tap` of UI into Target
        if UI has entry `tap` put `tap` into Action
        if UI has entry `select`
        begin
            put entry `select` of UI into Fields
            put entry `target` of Fields into Target
            put `select ` cat entry `value` of Fields into Action
        end
        if UI has entry `fill`
        begin
            put entry `fill` of UI into Fields
            put entry `target` of Fields into Target
            put `fill ` cat entry `value` of Fields into Action
        end
        if UI has entry `scroll` put entry `scroll` of UI into Target
    end
    else if Step has entry `expect`
    begin
        put `expect` into Actor
        put `Expect` into ActorLabel
        put entry `expect` of Step into Expect
        put entry `target` of Expect into Target
        put `—` into Action
        put empty into Expectation
        if Expect has entry `contains` put `contains ` cat entry `contains` of Expect into Expectation
        if Expect has entry `text` put `text = ` cat entry `text` of Expect into Expectation
        if Expect has entry `notContains` put `not contains ` cat entry `notContains` of Expect into Expectation
        if Expect has entry `visible` put `visible` into Expectation
        if Expect has entry `hidden` put `hidden` into Expectation
        if Expect has entry `value` put `value = ` cat entry `value` of Expect into Expectation
        if Expect has entry `count` put `count = ` cat entry `count` of Expect into Expectation
    end
    else if Step has entry `expectWire`
    begin
        put `wire` into Actor
        put `Wire` into ActorLabel
        put entry `expectWire` of Step into Wire
        put entry `request` of Wire into Target
        put `—` into Action
        put empty into Expectation
        if Wire has entry `match` put `match` into Expectation
        if Expectation is empty put `any` into Expectation
    end
    else if Step has entry `waitFor`
    begin
        put `expect` into Actor
        put `Expect` into ActorLabel
        put entry `waitFor` of Step into Wire
        put entry `target` of Wire into Target
        put `—` into Action
        put entry `state` of Wire into Expectation
    end
    else if Step has entry `delay`
    begin
        put `delay` into Actor
        put `Delay` into ActorLabel
        put `—` into Target
        put `wait ` cat entry `delay` of Step cat ` s (Demo)` into Action
        put `—` into Expectation
    end
    else
    begin
        put `connection` into Actor
        put `Connection` into ActorLabel
        put `—` into Action
        put `—` into Expectation
    end
    if RoomAliases has entry Target put entry Target of RoomAliases into Target
    put Id cat `  ` cat At cat `  ` cat ActorLabel cat `  ` cat Target cat `  ` cat Action into Detail
    if Step has entry `note`
    begin
        if entry `note` of Step is not empty put Detail cat ` — ` cat entry `note` of Step into Detail
    end
    return
!! @hash 2ea0c9d1
!! @verified b9d42057
!!!

!! Tint the actor cells by kind and mark the result cells as waiting.
PaintRows:
    put 0 into RowIndex
    while RowIndex is less than the count of ActorTokens
    begin
        put item RowIndex of ActorTokens into Actor
        if Actor is `controller` set cell colour Steps RowIndex 2 to `#2F75B5` `#E6EFF7`
        else if Actor is `ui` set cell colour Steps RowIndex 2 to `#D95A24` `#FDF0EA`
        else if Actor is `expect` set cell colour Steps RowIndex 2 to `#6B4FA1` `#F0ECF9`
        else if Actor is `wire` set cell colour Steps RowIndex 2 to `#0F7B6C` `#E5F4F1`
        else if Actor is `delay` set cell colour Steps RowIndex 2 to `#8A6D3B` `#F7F1E3`
        else set cell colour Steps RowIndex 2 to `#666666` `#F0F1F3`
        set cell colour Steps RowIndex 6 to `#C9CBD1`
        set cell alignment Steps RowIndex 6 to center
        put item RowIndex of StepDetails into Detail
        set cell tooltip Steps RowIndex 3 to Detail
        increment RowIndex
    end
    return
!! @hash e4383fba
!! @verified e4383fba
!!!

!! Load the group selector from the manifest; All/Local precede the library's own folders.
LoadGroups:
    clear GroupBox
    add `All` to GroupBox
    add `Local` to GroupBox
    if file `fixtures/local/scenarios/index.json` exists
    begin
        load LibText from `fixtures/local/scenarios/index.json`
        put json LibText into LibData
        if LibData is not empty
        begin
            if LibData has entry `groups` put entry `groups` of LibData into LibGroups else put `[]` into LibGroups
            put the count of LibGroups into LibGroupCount
            put 0 into LibGroupI
            while LibGroupI is less than LibGroupCount
            begin
                put item LibGroupI of LibGroups into LibGroup
                if LibGroup is not empty add LibGroup to GroupBox
                add 1 to LibGroupI
            end
        end
    end
    return
!! @hash 8930e270

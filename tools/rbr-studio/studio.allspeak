        end
    end
    if DraftGroup is empty put `Unsorted` into DraftGroup
    create NewScenarioGroupDlg on Win type lineedit title `New scenario` prompt `Group for the new scenario (blank to cancel)` value DraftGroup
    show NewScenarioGroupDlg
    put NewScenarioGroupDlg into DraftGroup
    if DraftGroup is empty return
    put empty into Brief
    put empty into PromptPath

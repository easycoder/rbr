!! @verified 2c9eb0c3
!!!

!! Ask the child to end. The exit event still arrives.
StopClicked:
    if Batching
    begin
        set the text of StatusLabel to `Stopping batch…`
        stop Batcher
        return
    end
    if Drafting
    begin
        set the text of StatusLabel to `Stopping draft…`
        stop Drafter
        return
    end
    if Deleting
    begin
        set the text of StatusLabel to `Stopping delete…`
        stop Deleter
        return
    end
    if Running
    begin
        set the text of StatusLabel to `Stopping…`
        stop Runner
    end
    else append `No run in progress.` to Log
    return
!! @hash aac6b50d
!! @verified aac6b50d
!!!

!! Stop any child before the window goes.
WinClosed:
    gosub to SaveStudioSettings
    if Batching stop Batcher
    if Grouping stop Grouper
    if Running stop Runner
    if Refreshing stop Refresher
    if Drafting stop Drafter
    if Deleting stop Deleter
    if Librarying stop Librarian
    return
!! @hash ea0f2c50
!! @verified 67e8e021
!!!

!! Save the geometry and the last-used Studio values while the window still exists.
!!
!! `on close` runs before the window disappears, so the geometry reads are valid; Quit and the window's X button both take this path.
SaveStudioSettings:
    put json `{}` into StudioSettings
    set entry `x` of StudioSettings to the x of Win
    set entry `y` of StudioSettings to the y of Win
    set entry `width` of StudioSettings to the width of Win
    set entry `height` of StudioSettings to the height of Win
    if CurrentGroup is not empty set entry `group` of StudioSettings to CurrentGroup
    if ScenarioPath is not empty set entry `scenario` of StudioSettings to ScenarioPath
    set entry `ssh` of StudioSettings to JournalSource
    set entry `day` of StudioSettings to JournalDay
    set entry `range` of StudioSettings to JournalRange
    save StudioSettings to `fixtures/local/studio-settings.json`
    return
!! @hash 0f4817f1
!! @verified
!!!

!! Close the Studio; the close handler writes the settings before the window goes.
QuitClicked:
    close Win
    return
!! @hash e944b197
!! @verified
!!!

!! A stdout line from the runner: raw JSON to the wire log, parsed events to
!! the table and the readable logs.
RunnerLine:
    put the line of Runner into LineText
    append LineText to WireLog
    put json LineText into Event
    if Event is empty return
    put entry `event` of Event into Kind
    if Kind is `step.started`
    begin
        put entry `stepId` of Event into StepId
        set the text of StatusLabel to `Running step ` cat StepId
        append `step ` cat StepId cat ` started` to Log
        gosub to FindStep
        if RowIndex is not -1 set cell Steps RowIndex 6 to `…`
    end
    else if Kind is `step.finished` gosub to MarkStep
    else if Kind is `log`
    begin
        put entry `source` of Event into Source
        put entry `message` of Event into Message
        if Source is `console` append Message to ConsoleLog
        else if Source is `wire` append Message to WireLog
        else append Message to Log
    end
    else if Kind is `artifact`
    begin
        if Event has entry `path` append entry `path` of Event to ArtifactsLog
    end
    else if Kind is `run.finished` gosub to FinishRun
    return
!! @hash 99a61d66
!! @verified 99a61d66
!!!

!! stderr is a separate event, and is red in both logs.
RunnerError:
    put the stderr line of Runner into Message
    append Message to ConsoleLog with color `#B00020`
    append `runner: ` cat Message to Log with color `#B00020`
    return
!! @hash 8794798c
!! @verified 8794798c
!!!

!! The child has ended. A run.finished usually precedes this; if it did not,
!! report the code here and release the buttons.
RunnerDone:
    put the exit code of Runner into ExitCode
    append `runner exit code ` cat ExitCode to Log
    enable RunBtn
    enable ValidateBtn
    enable DemoBtn
    enable RefreshBtn
    enable RefreshScenariosBtn
    enable DraftBtn
    gosub to SetDeleteButton
    disable StopBtn
    put 0 into Running
    if the text of StatusLabel is `Stopping…` set the text of StatusLabel to `Stopped`
    return
!! @hash 3f6cfed9
!! @verified d9cbf02d
!!!

!! Find the table row for StepId; RowIndex is -1 when it is absent.
FindStep:
    put -1 into RowIndex
    put 0 into Count
    while Count is less than the count of StepIds
    begin
        if item Count of StepIds is StepId put Count into RowIndex
        increment Count
    end
    return
!! @hash 7e5f2d6b
!! @verified 7e5f2d6b
!!!

!! Mark a step's result from a step.finished event.
MarkStep:
    put entry `stepId` of Event into StepId
    put entry `status` of Event into RunStatus
    gosub to FindStep
    if RowIndex is not -1
    begin
        if RunStatus is `passed`
        begin
            set cell Steps RowIndex 6 to `✓`
            set cell colour Steps RowIndex 6 to `#2E7D32`
            append `step ` cat StepId cat ` passed` to Log
        end
        else
        begin
            set cell Steps RowIndex 6 to `✗`
            set cell colour Steps RowIndex 6 to `#C0392B`
            append LineText to Log with color `#B00020`
            if Event has entry `failure`
            begin
                put entry `failure` of Event into Fields
                if Fields has entry `message` append entry `message` of Fields to Log with color `#B00020`
            end
        end
    end
    return
!! @hash 907db811
!! @verified 907db811
!!!

!! Finish a run: status line, buttons and the artefacts path.
FinishRun:
    put entry `status` of Event into RunStatus
    put entry `passed` of Event into Passed
    put entry `failed` of Event into Failed
    if RunStatus is `valid` set the text of StatusLabel to `validation valid`
    else if RunStatus is `invalid` set the text of StatusLabel to `validation invalid`
    else set the text of StatusLabel to `run ` cat RunStatus cat ` · ` cat Passed cat ` passed · ` cat Failed cat ` failed`
    append `run ` cat RunStatus cat ` (` cat Passed cat ` passed, ` cat Failed cat ` failed)` to Log
    enable RunBtn
    enable ValidateBtn
    enable DemoBtn
    enable RefreshBtn
    enable RefreshScenariosBtn
    enable DraftBtn
    gosub to SetDeleteButton
    disable StopBtn
    put 0 into Running
    if Event has entry `artifacts`
    begin
        put entry `artifacts` of Event into Artifacts
        if Artifacts has entry `dir` append `artefacts: ` cat entry `dir` of Artifacts to ArtifactsLog
    end
    return
!! @hash f2f70702
!! @verified 575d6f01
!!!
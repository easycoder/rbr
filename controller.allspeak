    variable NaturalPeriod
    variable MapFilename
    variable OnTime
    variable OffTime
    variable InPeriod
    variable NaturalPeriodActive
    variable NextAdvanceIdx
    variable NextAdvanceMin
    variable PI
    list PeriodList
    list PeriodSource

!! RBR is a heating control system based on Zigbee relays and thermometers.
!!
!! The script starts by declaring all the variables that it uses.
!   controller.allspeak - the main program script

	info `This is the controller script for RBR`

    script Controller

    use mqtt
    use email

    dictionary Credentials
    dictionary CredDict
    dictionary Map
    dictionary Profile
    dictionary Room
    dictionary Period
    dictionary Sender
    dictionary Senders
    dictionary ReceivedMessage
    dictionary Message
    dictionary Thermometers
    dictionary Thermometer
    dictionary Temperatures
    dictionary RoomSpec
    dictionary CalendarDay
    dictionary WaitForConfirmation
    queue MessageQueue
    list Profiles
    list Rooms
!	Shared room list: identity above profiles, per-profile state keyed by name.
    list ESRProfiles
    dictionary RoomStates
    list ESRIdentity
    list ESRList
    dictionary ESRNames
    dictionary ESRStates
    dictionary ESRProfile
    dictionary ESRRoom
    dictionary ESREntry
    dictionary ESRCopy
    dictionary MRStates
    list MRIdentity
    variable MaterialisedProfile
    dictionary MRTemp
    variable MRText
    dictionary CRProfile
    dictionary CRStates
    dictionary CRState
    variable CRStateIdx
    dictionary MRRoom
    dictionary MRState
    list CRIdentity
    dictionary CRIndex
    dictionary CRRoom
    dictionary CRTarget
    dictionary CRCopy
    variable ESRSel
    variable ESRP
    variable ESRI
    variable ESRName
    variable ESRCopyText
    variable MRIdx
    variable MRName
    variable CRIdx
    variable CRId
    variable CRName
    variable CRName0
    variable AddName
    variable CRCopyText
    list DiskRoomNames
    variable DRName
    list DiskIdentity
    dictionary DiskIdRoom
    variable DIIdx
    list URList
    dictionary AddStates
    dictionary InProfile
    dictionary InRooms
    list InKeys
    list InProfiles
    list MIRCurrent
    dictionary MIRByName
    dictionary MIRSeen
    dictionary MIRAdded
    dictionary OVSet
    dictionary OVOld
    dictionary OVNew
    list OVNames
    list OVInNames
    list OVOldRelays
    list OVNewRelays
    variable OVI
    variable OVJ
    variable OVName
    variable OVNewName
    variable OVCandidate
    variable OVOldRelaysText
    variable OVNewRelaysText
    variable OVSensor
    dictionary MIRRoom
    dictionary MIRIn
    dictionary MIRNew
    dictionary MIRCopy
    list MIRBuilt
    list MIRStateKeys
    variable MIRI
    variable MIRName
    variable MIRCopyText
    dictionary RUSNames
    dictionary RUSRoom
    list RUSRoomList
    variable RUSI
    variable RUSName
    variable InProfileCount
    variable InP
    list SenderKeys
    list Replies
    list CalendarData
    topic ServerTopic
    topic SenderTopic
    variable RoomCount
    variable RoomName
    variable RoomIndex
    variable SelectedProfile
    variable TempNow
    variable TempWas
    variable Target
    variable TargetWas
    variable PeriodWas
    variable PeriodActive
    variable Sensor
    variable Relays
    variable RelayState
    variable RelayStateWas
    variable SensorFresh
    variable SensorFreshWas
    variable RequestState
    variable RequestStateWas
    variable RequestName
    variable EventCount
    variable LastMapSave
    variable MapHasChanged
    dictionary MapDisk
    list DiskProfiles
    dictionary DiskProfile
    dictionary DiskRooms
    dictionary DiskRoom
    variable MapDiskText
    variable LastMapDiskText
    variable DPIdx
    variable DRIdx
    variable HeatingRequested
    variable Simulate
    variable Time
    variable Temp
    variable ImmediateUpdate
    variable UIRequestPending
    variable ConfirmationRequested
    variable StateChanged
    variable MessageText
    variable SenderName
    variable SenderQoS
    variable SenderKey
    variable Broker
    variable Username
    variable Password
    variable MAC
    variable MailServer
    variable MailLogin
    variable MailPassword
    variable MailFrom
    variable Action
    variable Mode
    variable Value
    variable Value2
    variable ThermometerUpdate
    dictionary ZigbeeTemps
    dictionary ZigbeeTemp
    list ZigbeeTempKeys
    variable ZK
    variable LoopCount
    variable UpdateCount
    variable StartedVersion
    variable CurrentVersion
    variable VersionCheckCounter
    variable DashboardEnabled
    variable WaitCounter
    variable PriorityRoomIndex
    variable TodayWas
    variable RelayFails
    list OldRelayFails
    list NewRelayFails
    list RoomRelays
    list RoomRelayFails
    variable RelayFailsThis
    variable RelayFailsWorst
    variable RelayCount
    variable FailedRelays
    variable BadRelayName

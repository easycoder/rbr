!   retire-rbr-now.allspeak
!
!   One-shot migration: strip the fields left behind by the RBR-Now
!   retirement and by the earlier legacy UI. Run it once, on a controller
!   whose map still carries them, after the controller has switched to the
!   Zigbee-only build.
!
!   Room level:
!     relayType        RBR-Now or Zigbee - no longer distinguishes anything
!     ssid             RBR-Now master/slave SSID; never read from a room
!
!   Map level:
!     ssid, password, email, message, address, extenders,
!     controller-ssid, controller-password, user-password
!                      written by the legacy UI or the RBR-Now hub
!                      provisioning screen, and read by nothing now
!
!   Reads:   map.json
!   Writes:  map-retired.json   (inspect, diff, then mv to replace)
!
!   Run with:   allspeak retire-rbr-now.allspeak

    script RetireRBRNow

    dictionary Map
    list Profiles
    dictionary Profile
    list Rooms
    dictionary Room

    variable MapFilename
    variable OutputFilename
    variable PIdx
    variable PCount
    variable RIdx
    variable RCount
    variable RoomName
    variable ProfileName
    variable Removed

    set MapFilename to `map.json`
    set OutputFilename to `map-retired.json`

    log `retire-rbr-now: reading ` cat MapFilename
    if file MapFilename exists load Map from MapFilename
    else
    begin
        log `retire-rbr-now: ` cat MapFilename cat ` not found - aborting`
        exit
    end

    set Removed to 0

    ! Map-level fields first: they belong to the map, not to any room.
    if Map has entry `ssid`
    begin
        delete entry `ssid` of Map
        increment Removed
    end
    if Map has entry `password`
    begin
        delete entry `password` of Map
        increment Removed
    end
    if Map has entry `email`
    begin
        delete entry `email` of Map
        increment Removed
    end
    if Map has entry `message`
    begin
        delete entry `message` of Map
        increment Removed
    end
    if Map has entry `address`
    begin
        delete entry `address` of Map
        increment Removed
    end
    if Map has entry `extenders`
    begin
        delete entry `extenders` of Map
        increment Removed
    end
    if Map has entry `controller-ssid`
    begin
        delete entry `controller-ssid` of Map
        increment Removed
    end
    if Map has entry `controller-password`
    begin
        delete entry `controller-password` of Map
        increment Removed
    end
    if Map has entry `user-password`
    begin
        delete entry `user-password` of Map
        increment Removed
    end

    put entry `profiles` of Map into Profiles
    put the count of Profiles into PCount
    set PIdx to 0
    while PIdx is less than PCount
    begin
        put item PIdx of Profiles into Profile
        put entry `name` of Profile into ProfileName
        log `Profile: ` cat ProfileName
        put entry `rooms` of Profile into Rooms
        put the count of Rooms into RCount
        set RIdx to 0
        while RIdx is less than RCount
        begin
            put item RIdx of Rooms into Room
            put entry `name` of Room into RoomName
            if Room has entry `relayType`
            begin
                delete entry `relayType` of Room
                increment Removed
            end
            if Room has entry `ssid`
            begin
                delete entry `ssid` of Room
                increment Removed
            end
            log `  ` cat RoomName cat ` cleaned`
            set item RIdx of Rooms to Room
            increment RIdx
        end
        set entry `rooms` of Profile to Rooms
        set item PIdx of Profiles to Profile
        increment PIdx
    end
    set entry `profiles` of Map to Profiles

    save prettify Map to OutputFilename
    log `retire-rbr-now: removed ` cat Removed cat ` field(s); wrote ` cat OutputFilename
    log `Inspect with: diff ` cat MapFilename cat ` ` cat OutputFilename
    log `Replace with: mv ` cat OutputFilename cat ` ` cat MapFilename
    exit

[Unit]
Description=RBR component and heating watchdog (restart down or unresponsive services)

[Service]
Type=oneshot
# Runs as root so it can restart mosquitto/zigbee2mqtt/bridge/controller.
# The script lives in the controller runtime dir (/home/graham/rbr on the
# default install) so the hourly updater refreshes it when a new release
# ships — rbr-watchdog.sh is part of rbr-controller.tar.gz and is applied
# by rbr-updater.py like any other runtime file. Installed by rbr-setup.sh
# STEP 6b.
#
# The heating check can restart all four services, so allow for four sequential
# systemctl restarts; a slow Zigbee2MQTT start is the long pole.
ExecStart=/home/graham/rbr/rbr-watchdog.sh
TimeoutStartSec=300
SyslogIdentifier=rbr-watchdog
